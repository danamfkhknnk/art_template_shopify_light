<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Iconify Icons (icon library via CDN) -->
    <link rel="preconnect" href="https://api.iconify.design" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.2/dist/iconify-icon.min.js"></script>

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Tailwind CSS %}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="watercolor-noise">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    <!-- GSAP Core + ScrollTrigger (load synchronously before init) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- GSAP Animations Init -->
    {{ 'gsap-init.js' | asset_url | script_tag }}

    <!-- Smooth Scroll for Anchor Links -->
    <script>
      // Use event delegation - check all anchor clicks
      document.addEventListener('click', function(e) {
        var anchor = e.target.closest('a');
        if (!anchor) return;
        
        var href = anchor.getAttribute('href');
        if (!href) return;
        
        // Check for cross-page anchor links (/#contact, /#faq, /#gallery)
        var isCrossPageAnchor = href.includes('#contact') || href.includes('#faq') || href.includes('#gallery');
        if (isCrossPageAnchor) {
          var hashIndex = href.indexOf('#');
          var hash = href.substring(hashIndex);
          var target = document.querySelector(hash);
          
          if (target) {
            // We're on the same page (homepage), just scroll
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else if (hashIndex === 0 || href.startsWith('/') || href.startsWith('{{ routes.root_url }}')) {
            // We're on a different page, let browser navigate then scroll
            sessionStorage.setItem('scrollToAnchor', hash);
          }
        }
        
        // Handle same-page anchor links (#contact, #faq, etc.)
        if (href.startsWith('#') && href !== '#') {
          var target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });

      // Check for anchor to scroll to on page load (from cross-page navigation)
      function attemptScrollToAnchor() {
        var scrollToAnchor = sessionStorage.getItem('scrollToAnchor');
        if (!scrollToAnchor) return;
        
        sessionStorage.removeItem('scrollToAnchor');
        
        var tryScroll = function(attempts) {
          var target = document.querySelector(scrollToAnchor);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else if (attempts > 0) {
            setTimeout(function() { tryScroll(attempts - 1); }, 200);
          }
        };
        
        // Start with 10 attempts (2 seconds total)
        setTimeout(function() { tryScroll(10); }, 300);
      }

      // Run on DOMContentLoaded
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attemptScrollToAnchor);
      } else {
        attemptScrollToAnchor();
      }

      // Also run on pageshow (for bfcache)
      window.addEventListener('pageshow', function(e) {
        if (e.persisted) {
          attemptScrollToAnchor();
        }
      });

      // Header background on scroll
      var header = document.querySelector('header');
      if (header) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 50) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        });
      }
    </script>
  </body>
</html>
