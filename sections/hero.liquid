<section data-gs-section="hero" class="relative w-full min-h-screen flex flex-col overflow-x-hidden">

  <!-- Artwork Carousel (full background) -->
  <div class="absolute inset-0" style="background: var(--bg-about);">
    <!-- Slide 1 -->
    <div class="hero-slide absolute inset-0 active" data-slide="0">
      {% if section.settings.image_1 != blank %}
        <img
          src="{{ section.settings.image_1 | image_url: width: 1920 }}"
          alt="{{ section.settings.image_1.alt | default: 'Hero artwork 1' }}"
          class="w-full h-full object-cover md:object-cover object-fill transition-opacity duration-[1200ms] ease-in-out"
          loading="eager"
          width="1920"
          height="1080"
        >
      {% else %}
        <img
          src="{{ 'gallery.webp' | asset_url }}"
          alt="Gallery artwork 1"
          class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
          loading="eager"
          width="1920"
          height="1080"
        >
      {% endif %}
      <div class="absolute inset-0" style="background: rgba(255,255,255,0.2);"></div>
    </div>
    <!-- Slide 2 -->
    <div class="hero-slide absolute inset-0" data-slide="1">
      {% if section.settings.image_2 != blank %}
        <img
          src="{{ section.settings.image_2 | image_url: width: 1920 }}"
          alt="{{ section.settings.image_2.alt | default: 'Hero artwork 2' }}"
          class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
          loading="lazy"
          width="1920"
          height="1080"
        >
      {% else %}
        <img
          src="{{ 'gallery2.jpg' | asset_url }}"
          alt="Gallery artwork 2"
          class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
          loading="lazy"
          width="1920"
          height="1080"
        >
      {% endif %}
      <div class="absolute inset-0" style="background: rgba(255,255,255,0.2);"></div>
    </div>
    <!-- Slide 3 -->
    <div class="hero-slide absolute inset-0" data-slide="2">
      {% if section.settings.image_3 != blank %}
        <img
          src="{{ section.settings.image_3 | image_url: width: 1920 }}"
          alt="{{ section.settings.image_3.alt | default: 'Hero artwork 3' }}"
          class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
          loading="lazy"
          width="1920"
          height="1080"
        >
      {% else %}
        <img
          src="{{ 'gallery3.jpg' | asset_url }}"
          alt="Gallery artwork 3"
          class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
          loading="lazy"
          width="1920"
          height="1080"
        >
      {% endif %}
      <div class="absolute inset-0" style="background: rgba(255,255,255,0.2);"></div>
    </div>

    <!-- Watercolor wash overlay -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 30% 50%, rgba(196,114,127,0.06) 0%, transparent 50%), radial-gradient(ellipse at 70% 30%, rgba(155,142,196,0.04) 0%, transparent 50%);"></div>
  </div>

  <!-- Hero bottom text box -->
  <div class="absolute bottom-0 left-0 z-50 flex justify-center px-4 pb-8 md:pb-12">
    <div class="hero-text-box text-center" style="width: 35vw; background: rgba(0,0,0,0.35); backdrop-filter: blur(1px); padding: 2rem 4rem;">
      {% if section.settings.tagline != blank %}
        <h1 class="font-display leading-snug" style="color: #F5EDE0; font-weight: 500; font-size: clamp(1.3rem, 1vw, 2rem); text-shadow: 0 1px 8px rgba(0,0,0,0.4); text-align: justify;">
          {{ section.settings.tagline }}
        </h1>
      {% endif %}
    </div>
  </div>

  <!-- Scroll indicator -->
  {% if section.settings.show_scroll %}
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 z-10 hidden md:flex">
      <span class="text-caption tracking-widest uppercase" style="color: var(--color-muted); font-weight: 800;">{{ section.settings.scroll_label }}</span>
      <div class="w-6 h-10 rounded-full flex justify-center pt-2" style="border: 3px solid rgba(196,114,127,1);">
        <div class="w-1 h-2 rounded-full" style="background: var(--color-blush); animation: bounce-dot 2s ease infinite;"></div>
      </div>
    </div>
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var slides = document.querySelectorAll('.hero-slide');
    var dots = document.querySelectorAll('.hero-dot');
    var currentIndex = 0;
    var isPlaying = true;
    var interval;

    function goToSlide(index) {
      slides.forEach(function(s) { s.classList.remove('active'); s.style.opacity = '0'; });
      dots.forEach(function(d) {
        d.style.background = 'rgba(45,42,38,0.15)';
        d.classList.remove('active');
      });

      currentIndex = index;
      slides[currentIndex].classList.add('active');
      slides[currentIndex].style.opacity = '1';
      dots[currentIndex].style.background = 'var(--color-blush)';
      dots[currentIndex].classList.add('active');
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slides.length);
    }

    function startAutoPlay() {
      interval = setInterval(nextSlide, 4000);
    }

    function stopAutoPlay() {
      clearInterval(interval);
    }

    // Initialize first slide
    goToSlide(0);

    // Dot navigation
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        stopAutoPlay();
        goToSlide(parseInt(this.dataset.goto));
        if (isPlaying) startAutoPlay();
      });
    });

    startAutoPlay();
  });
</script>

<style>
  /* Slide transitions */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .hero-slide.active {
    opacity: 1;
  }

  /* Marquee */
  .marquee-track {
    display: flex;
    white-space: nowrap;
    animation: marquee-scroll 40s linear infinite;
    width: max-content;
  }
  .marquee-item {
    font-family: var(--font-display--family);
    font-size: clamp(0.85rem, 2vw, 1.2rem);
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-blush) 0%, var(--color-lavender) 50%, var(--color-sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.35;
  }

  @keyframes bounce-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(12px); opacity: 0.3; }
  }

  /* GSAP word split */
  .gsap-word {
    display: inline-block;
  }

  /* Hero text box */
  .hero-text-box {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-text-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Heading",
      "default": "We are a team of artists based in Asia, providing budget friendly and high quality Vtuber and illustrations services. As of today, we have created more than 500 Vtuber models, come join our family NOW!!!",
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Background Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Background Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Background Image 3"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show Scroll Indicator",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Scroll Label",
      "default": "Scroll"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "tagline": "Every Character Has a Story",
        "show_scroll": true,
        "scroll_label": "Scroll"
      }
    }
  ]
}
{% endschema %}
