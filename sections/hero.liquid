<section data-gs-section="hero" class="relative w-full min-h-screen flex flex-col overflow-x-hidden">

  <!-- Artwork Carousel (full background) -->
  <div class="absolute inset-0" style="background: var(--bg-about);">
    {% assign hero_items = shop.metaobjects.hero.values %}
    {% assign hero_count = 0 %}
    {% for item in hero_items %}
      {% if item.image %}
        {% assign hero_count = hero_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if hero_count > 0 %}
      {% for item in hero_items %}
        {% if item.image %}
          <div class="hero-slide absolute inset-0 {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
            <img
              src="{{ item.image | image_url: width: 1920 }}"
              alt="{{ item.image.alt | default: 'Hero artwork' }}"
              class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="1920"
              height="1080"
            >
            <div class="absolute inset-0" style="background: rgba(255,255,255,0.2);"></div>
            <!-- Watercolor wash overlay -->
            <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 30% 50%, rgba(196,114,127,0.06) 0%, transparent 50%), radial-gradient(ellipse at 70% 30%, rgba(155,142,196,0.04) 0%, transparent 50%);"></div>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="hero-slide absolute inset-0 active" data-slide="0">
          <img
            src="{{ 'hero.avif' | asset_url }}"
            alt="Hero artwork"
            class="w-full h-full object-cover"
            loading="eager"
            width="1920"
            height="1080"
          >
        <div class="absolute inset-0" style="background: rgba(255,255,255,0.2);"></div>
        <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 30% 50%, rgba(196,114,127,0.06) 0%, transparent 50%), radial-gradient(ellipse at 70% 30%, rgba(155,142,196,0.04) 0%, transparent 50%);"></div>
      </div>
    {% endif %}
  </div>

  <!-- Hero bottom text box -->
  <div class="absolute bottom-0 left-0 z-50 flex justify-center px-4 pb-8 md:pb-12">
    <div class="hero-text-box text-center" style="width: 35vw; background: rgba(0,0,0,0.35); backdrop-filter: blur(1px); padding: 2rem 4rem;">
      {% if section.settings.tagline != blank %}
        <h1 class="font-display leading-snug" style="color: #F5EDE0; font-weight: 500; font-size: clamp(1.3rem, 1vw, 2rem); text-shadow: 0 1px 8px rgba(0,0,0,0.4); text-align: justify;">
          {{ section.settings.tagline }}
        </h1>
      {% endif %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var slides = document.querySelectorAll('.hero-slide');

    // Single image (metaobject empty): show it, no slideshow
    if (slides.length <= 1) {
      if (slides.length === 1) {
        slides[0].classList.add('active');
        slides[0].style.opacity = '1';
      }
      return;
    }

    // Multiple slides: run the autoplay carousel
    var currentIndex = 0;
    var interval;

    function goToSlide(index) {
      slides.forEach(function(s) { s.classList.remove('active'); s.style.opacity = '0'; });
      currentIndex = index;
      slides[currentIndex].classList.add('active');
      slides[currentIndex].style.opacity = '1';
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slides.length);
    }

    function startAutoPlay() {
      interval = setInterval(nextSlide, 4000);
    }

    function stopAutoPlay() {
      clearInterval(interval);
    }

    // Initialize first slide
    goToSlide(0);
    startAutoPlay();
  });
</script>

<style>
  /* Slide transitions */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .hero-slide.active {
    opacity: 1;
  }

  /* Marquee */
  .marquee-track {
    display: flex;
    white-space: nowrap;
    animation: marquee-scroll 40s linear infinite;
    width: max-content;
  }
  .marquee-item {
    font-family: var(--font-display--family);
    font-size: clamp(0.85rem, 2vw, 1.2rem);
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-blush) 0%, var(--color-lavender) 50%, var(--color-sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.35;
  }

  @keyframes bounce-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(12px); opacity: 0.3; }
  }

  /* GSAP word split */
  .gsap-word {
    display: inline-block;
  }

  /* Hero text box */
  .hero-text-box {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hero-text-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  /* Scroll indicator: frosted glass — nearly invisible bg, blurs whatever is behind it */
  .scroll-indicator {
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border-radius: 9999px;
    padding: 0.75rem 1.1rem;
  }
  .scroll-indicator span {
    text-shadow: 0 1px 6px rgba(255,255,255,0.4);
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Heading",
      "default": "We are a team of artists based in Asia, providing budget friendly and high quality Vtuber and illustrations services. As of today, we have created more than 500 Vtuber models, come join our family NOW!!!"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show Scroll Indicator",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Scroll Label",
      "default": "Let's Go!"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "tagline": "We are a team of artists based in Asia, providing budget friendly and high quality Vtuber and illustrations services. As of today, we have created more than 500 Vtuber models, come join our family NOW!!!",
        "show_scroll": true,
        "scroll_label": "Let's Go"
      }
    }
  ]
}
{% endschema %}
