<section data-gs-section="hero" class="relative w-full overflow-hidden min-h-[100vh] min-h-[100dvh] bg-[var(--color-foreground)]">

  {% assign hero_items = shop.metaobjects.hero.values %}
  {% assign hero_count = 0 %}
  {% for item in hero_items %}
    {% if item.img %}
      {% assign hero_count = hero_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  <!-- Background artwork (crossfades between active Hero Metaobjects) -->
  <div class="absolute inset-0">
    {% if hero_count > 0 %}
      {% for item in hero_items %}
        {% if item.img %}
          <div class="hero-bg-slide absolute inset-0 opacity-0 transition-opacity duration-[1100ms] ease-in-out{% if forloop.first %} opacity-100{% endif %}" data-hero-index="{{ forloop.index0 }}">
            <img
              src="{{ item.img | image_url: width: 1920 }}"
              alt="{{ item.img.alt | default: item.title | default: 'Hero artwork' }}"
              class="w-full h-full object-cover object-right"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="1920"
              height="1080"
            >
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="hero-bg-slide absolute inset-0 opacity-100 transition-opacity duration-[1100ms] ease-in-out" data-hero-index="0">
        <img
          src="{{ 'hero.avif' | asset_url }}"
          alt="Hero artwork"
          class="w-full h-full object-cover"
          loading="eager"
          width="1920"
          height="1080"
        >
      </div>
    {% endif %}

    <!-- Readability + watercolor-brand overlay (warm, matches site palette rather than the cool reference tones) -->
    <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(180deg,rgba(45,42,38,.15)_0%,rgba(45,42,38,.35)_55%,rgba(45,42,38,.85)_100%),linear-gradient(90deg,rgba(45,42,38,.75)_0%,rgba(45,42,38,.25)_45%,rgba(45,42,38,.1)_100%)]"></div>
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_25%_60%,rgba(196,114,127,.14)_0%,transparent_55%),radial-gradient(ellipse_at_75%_20%,rgba(155,142,196,.12)_0%,transparent_55%)]"></div>
  </div>

  <!-- Foreground content -->
  <div class="relative z-10 flex min-h-[100vh] min-h-[100dvh] flex-col justify-end px-4 pb-8 sm:px-6 lg:px-16 lg:pb-12">
    <div class="mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end">

      <div class="mb-10 flex flex-col gap-10 lg:mb-14 lg:flex-row lg:items-end lg:justify-between lg:gap-8">

        <!-- LEFT CONTENT -->
        <div class="max-w-xl">
          {% if hero_count > 0 %}
            {% for item in hero_items %}
              {% if item.img %}
                <div class="hero-content-slide{% unless forloop.first %} hidden{% endunless %}" data-hero-index="{{ forloop.index0 }}">
                  {% if item.title != blank %}
                    <h1 data-gs="hero-title" class="font-display mb-5 uppercase font-extrabold leading-[0.95] break-words text-[var(--color-cream)] text-[clamp(2.25rem,5.5vw,4.5rem)] [text-shadow:0_4px_30px_rgba(0,0,0,.35)]">
                      {{ item.title | newline_to_br }}
                    </h1>
                  {% endif %}
                  {% if item.desc != blank %}
                    <div data-gs="hero-desc" class="text-body leading-relaxed text-[rgba(245,237,224,.85)] max-w-[30rem]">
                      {{ item.desc }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}

          <div data-gs="hero-buttons" class="mt-8 flex items-center gap-4">
            <a href="{{ section.settings.explore_link | default: '#team' }}" class="btn-primary inline-flex items-center gap-2">
              <span>{{ section.settings.explore_label }}</span>
            </a>
          </div>
        </div>

        <!-- FEATURED CARDS: every Hero Metaobject rendered as a clickable card via its own `card` image -->
        {% if hero_count > 1 %}
          <div class="w-full lg:w-auto">
            <p data-gs="hero-featured" class="mb-4 inline-flex items-center gap-2 text-caption font-medium uppercase tracking-[0.2em] text-[rgba(245,237,224,.75)]">
              {{ section.settings.featured_label | default: 'Featured' }}
              <span class="hero-featured-dot h-2 w-2 rounded-full bg-[var(--color-sage)] animate-pulse"></span>
            </p>

            <div class="flex gap-3 overflow-x-auto py-2 pl-2 no-scrollbar sm:gap-4 lg:overflow-visible">
              {% for item in hero_items %}
                {% if item.img %}
                  <button
                    type="button"
                    data-gs="hero-card"
                    class="hero-card group relative shrink-0 w-[clamp(6.5rem,9vw,8.5rem)] aspect-[3/4] overflow-hidden rounded-2xl transition-all duration-300 shadow-[0_8px_30px_rgba(45,42,38,.25)] outline outline-2 outline-offset-2 outline-transparent hover:-translate-y-1 aria-[current=true]:outline-[var(--color-cream)]"
                    data-hero-index="{{ forloop.index0 }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    {% assign card_image = item.card | default: item.img %}
                    {% if card_image %}
                      <img src="{{ card_image | image_url: width: 400 }}" alt="{{ item.title | default: 'Featured card' }}" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
                    {% endif %}
                    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_45%,rgba(45,42,38,.85)_100%)]"></div>
                    {% if item.title != blank %}
                      <span class="absolute bottom-3 left-3 right-3 truncate text-left text-body-sm font-bold uppercase text-[var(--color-cream)]">{{ item.title }}</span>
                    {% endif %}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

      <!-- BOTTOM NAVIGATION -->
      {% if hero_count > 1 %}
        <div data-gs="hero-nav" class="flex items-center gap-4">
          <button type="button" class="hero-prev hero-nav-btn flex h-11 w-11 shrink-0 items-center justify-center rounded-full transition-all duration-300 border-[1.5px] border-[rgba(245,237,224,.4)] bg-[rgba(45,42,38,.15)] text-[var(--color-cream)] backdrop-blur-[2px] hover:border-[var(--color-cream)] hover:bg-[rgba(45,42,38,.3)] hover:-translate-y-0.5" aria-label="Previous slide">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" class="hero-next hero-nav-btn flex h-11 w-11 shrink-0 items-center justify-center rounded-full transition-all duration-300 border-[1.5px] border-[rgba(245,237,224,.4)] bg-[rgba(45,42,38,.15)] text-[var(--color-cream)] backdrop-blur-[2px] hover:border-[var(--color-cream)] hover:bg-[rgba(45,42,38,.3)] hover:-translate-y-0.5" aria-label="Next slide">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div class="hero-progress-track relative h-px flex-1 overflow-hidden rounded-full bg-[rgba(245,237,224,.25)]">
            <div class="hero-progress-fill absolute inset-y-0 left-0 rounded-full bg-[var(--color-cream)] transition-[width] duration-500 ease-out" style="width: {{ 100.0 | divided_by: hero_count }}%;"></div>
          </div>
          <span class="hero-index shrink-0 font-display text-2xl font-bold tabular-nums text-[var(--color-cream)]">01</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('[data-gs-section="hero"]');
    if (!section) return;

    var bgSlides = Array.prototype.slice.call(section.querySelectorAll('.hero-bg-slide'));
    var contentSlides = Array.prototype.slice.call(section.querySelectorAll('.hero-content-slide'));
    var cards = Array.prototype.slice.call(section.querySelectorAll('[data-gs="hero-card"]'));
    var total = bgSlides.length;
    if (total <= 1) return;

    var indexEl = section.querySelector('.hero-index');
    var progressFill = section.querySelector('.hero-progress-fill');
    var current = 0;
    var autoplayInterval;

    function pad(n) {
      return n < 9 ? '0' + (n + 1) : String(n + 1);
    }

    function setActive(index) {
      current = ((index % total) + total) % total;

      bgSlides.forEach(function (el) {
        var isActive = Number(el.dataset.heroIndex) === current;
        el.classList.toggle('opacity-100', isActive);
        el.classList.toggle('opacity-0', !isActive);
      });
      contentSlides.forEach(function (el) {
        el.classList.toggle('hidden', Number(el.dataset.heroIndex) !== current);
      });
      cards.forEach(function (el) {
        var isActive = Number(el.dataset.heroIndex) === current;
        el.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      if (indexEl) indexEl.textContent = pad(current);
      if (progressFill) progressFill.style.width = ((current + 1) / total * 100) + '%';
    }

    function stopAutoplay() {
      clearInterval(autoplayInterval);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayInterval = setInterval(function () { setActive(current + 1); }, 6000);
    }

    section.querySelectorAll('.hero-prev').forEach(function (btn) {
      btn.addEventListener('click', function () { setActive(current - 1); startAutoplay(); });
    });
    section.querySelectorAll('.hero-next').forEach(function (btn) {
      btn.addEventListener('click', function () { setActive(current + 1); startAutoplay(); });
    });

    cards.forEach(function (card) {
      card.addEventListener('click', function () {
        setActive(Number(card.dataset.heroIndex));
        startAutoplay();
      });
    });

    setActive(0);
    startAutoplay();
  });
</script>

<style>
  /* Tailwind has no utility to hide scrollbars cross-browser. */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "explore_label",
      "label": "CTA button label",
      "default": "See Our Team"
    },
    {
      "type": "url",
      "id": "explore_link",
      "label": "CTA button link",
      "info": "Defaults to the Our Team section (#team) when left blank."
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured cards label",
      "default": "Featured"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "explore_label": "See Our Team",
        "featured_label": "Featured"
      }
    }
  ]
}
{% endschema %}
