<section class="relative w-full min-h-screen flex flex-col overflow-hidden" style="background: var(--color-background);">

  <!-- Artwork Carousel (full background) -->
  <div class="absolute inset-0 -z-0">
    <!-- Slide 1 -->
    <div class="hero-slide absolute inset-0 active" data-slide="0">
      <img
        src="{{ 'gallery1.jpg' | asset_url }}"
        alt="Gallery artwork 1"
        class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
        loading="eager"
        width="1920"
        height="1080"
      >
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(250,247,242,0.3) 0%, rgba(250,247,242,0.15) 40%, rgba(250,247,242,0.6) 70%, rgba(250,247,242,0.95) 100%);"></div>
    </div>
    <!-- Slide 2 -->
    <div class="hero-slide absolute inset-0" data-slide="1">
      <img
        src="{{ 'gallery2.jpg' | asset_url }}"
        alt="Gallery artwork 2"
        class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
        loading="lazy"
        width="1920"
        height="1080"
      >
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(250,247,242,0.3) 0%, rgba(250,247,242,0.15) 40%, rgba(250,247,242,0.6) 70%, rgba(250,247,242,0.95) 100%);"></div>
    </div>
    <!-- Slide 3 -->
    <div class="hero-slide absolute inset-0" data-slide="2">
      <img
        src="{{ 'gallery3.jpg' | asset_url }}"
        alt="Gallery artwork 3"
        class="w-full h-full object-cover transition-opacity duration-[1200ms] ease-in-out"
        loading="lazy"
        width="1920"
        height="1080"
      >
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(250,247,242,0.3) 0%, rgba(250,247,242,0.15) 40%, rgba(250,247,242,0.6) 70%, rgba(250,247,242,0.95) 100%);"></div>
    </div>

    <!-- Watercolor wash overlay -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 30% 50%, rgba(196,114,127,0.06) 0%, transparent 50%), radial-gradient(ellipse at 70% 30%, rgba(155,142,196,0.04) 0%, transparent 50%);"></div>
  </div>

  <!-- Content overlay -->
  <div class="relative z-10 section-content w-full flex-1 flex flex-col justify-end pb-24 md:pb-28 pt-28 md:pt-36 px-4">

    <!-- Top: Slide indicators + label -->
    <div class="absolute top-28 md:top-36 left-4 right-4 flex items-center justify-between">
      <!-- Slide label -->
      <div class="reveal">
        <p class="text-caption tracking-[0.15em] uppercase font-medium" style="color: var(--color-blush);">
          Artwork <span id="hero-current-slide">01</span> / <span id="hero-total-slides">03</span>
        </p>
      </div>

      <!-- Pause/Play button -->
      <button id="hero-pause-btn" class="hidden md:flex w-8 h-8 rounded-full items-center justify-center transition-all duration-300 reveal reveal-delay-1" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); backdrop-filter: blur(8px);">
        <svg id="hero-pause-icon" class="w-3.5 h-3.5" style="color: var(--color-foreground);" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
        <svg id="hero-play-icon" class="w-3.5 h-3.5 hidden" style="color: var(--color-foreground);" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </button>
    </div>

    <!-- Main text content -->
    <div class="max-w-2xl">
      {% if section.settings.subheading != blank %}
        <p class="text-caption tracking-[0.2em] uppercase mb-4 font-medium inline-flex items-center gap-2 px-4 py-2 rounded-full reveal" style="background: rgba(255,255,255,0.7); backdrop-filter: blur(8px); border: 1px solid rgba(45,42,38,0.06); color: var(--color-blush);">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <h1 class="font-display leading-[1.05] mb-5 reveal reveal-delay-1" style="color: var(--color-foreground); font-size: clamp(2.2rem, 5vw, 4rem);">
        {{ section.settings.tagline }}
      </h1>

      {% if section.settings.description != blank %}
        <p class="text-body-lg mb-8 leading-relaxed max-w-lg reveal reveal-delay-2" style="color: var(--color-muted);">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <div class="flex items-center gap-4 flex-wrap reveal reveal-delay-2">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="btn-primary inline-flex items-center gap-2">
            <span>{{ section.settings.button_label }}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        {% endif %}

        <!-- Slide dots -->
        <div class="flex items-center gap-2 ml-2">
          <button data-goto="0" class="hero-dot w-2 h-2 rounded-full transition-all duration-300 active" style="background: var(--color-blush);"></button>
          <button data-goto="1" class="hero-dot w-2 h-2 rounded-full transition-all duration-300" style="background: rgba(45,42,38,0.15);"></button>
          <button data-goto="2" class="hero-dot w-2 h-2 rounded-full transition-all duration-300" style="background: rgba(45,42,38,0.15);"></button>
        </div>
      </div>

      <!-- Stats row -->
      <div class="flex items-center gap-8 mt-10 reveal reveal-delay-3">
        <div class="text-center lg:text-left">
          <p class="text-xl font-display font-bold gradient-text">500+</p>
          <p class="text-caption" style="color: var(--color-muted);">Artworks</p>
        </div>
        <div class="w-px h-8" style="background: rgba(45,42,38,0.1);"></div>
        <div class="text-center lg:text-left">
          <p class="text-xl font-display font-bold gradient-text">200+</p>
          <p class="text-caption" style="color: var(--color-muted);">Happy Clients</p>
        </div>
        <div class="w-px h-8" style="background: rgba(45,42,38,0.1);"></div>
        <div class="text-center lg:text-left">
          <p class="text-xl font-display font-bold gradient-text">8+</p>
          <p class="text-caption" style="color: var(--color-muted);">Years Exp</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  {% if section.settings.show_scroll %}
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 z-10 hidden md:flex">
      <span class="text-caption tracking-widest uppercase" style="color: var(--color-muted);">Scroll</span>
      <div class="w-6 h-10 rounded-full flex justify-center pt-2" style="border: 1.5px solid rgba(196,114,127,0.3);">
        <div class="w-1 h-2 rounded-full" style="background: var(--color-blush); animation: bounce-dot 2s ease infinite;"></div>
      </div>
    </div>
  {% endif %}

  <!-- Marquee bottom strip -->
  <div class="absolute bottom-0 left-0 right-0 z-10 w-full overflow-hidden py-3" style="background: rgba(250,247,242,0.8); backdrop-filter: blur(12px); border-top: 1px solid rgba(45,42,38,0.04);">
    <div class="marquee-track">
      {% for i in (1..8) %}
        <span class="marquee-item">{{ section.settings.tagline }}&nbsp;&mdash;&nbsp;</span>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    const currentSlideEl = document.getElementById('hero-current-slide');
    const pauseBtn = document.getElementById('hero-pause-btn');
    const pauseIcon = document.getElementById('hero-pause-icon');
    const playIcon = document.getElementById('hero-play-icon');
    let currentIndex = 0;
    let isPlaying = true;
    let interval;

    function goToSlide(index) {
      slides.forEach(s => { s.classList.remove('active'); s.style.opacity = '0'; });
      dots.forEach(d => {
        d.style.background = 'rgba(45,42,38,0.15)';
        d.classList.remove('active');
      });

      currentIndex = index;
      slides[currentIndex].classList.add('active');
      slides[currentIndex].style.opacity = '1';
      dots[currentIndex].style.background = 'var(--color-blush)';
      dots[currentIndex].classList.add('active');
      if (currentSlideEl) currentSlideEl.textContent = String(currentIndex + 1).padStart(2, '0');
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slides.length);
    }

    function startAutoPlay() {
      interval = setInterval(nextSlide, 4000);
    }

    function stopAutoPlay() {
      clearInterval(interval);
    }

    // Initialize first slide
    goToSlide(0);

    // Dot navigation
    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        stopAutoPlay();
        goToSlide(parseInt(this.dataset.goto));
        if (isPlaying) startAutoPlay();
      });
    });

    // Pause/Play toggle
    pauseBtn.addEventListener('click', function() {
      isPlaying = !isPlaying;
      if (isPlaying) {
        startAutoPlay();
        pauseIcon.classList.remove('hidden');
        playIcon.classList.add('hidden');
      } else {
        stopAutoPlay();
        pauseIcon.classList.add('hidden');
        playIcon.classList.remove('hidden');
      }
    });

    startAutoPlay();
  });
</script>

<style>
  /* Slide transitions */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .hero-slide.active {
    opacity: 1;
  }

  /* Marquee */
  .marquee-track {
    display: flex;
    white-space: nowrap;
    animation: marquee-scroll 40s linear infinite;
    width: max-content;
  }
  .marquee-item {
    font-family: var(--font-display--family);
    font-size: clamp(0.85rem, 2vw, 1.2rem);
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-blush) 0%, var(--color-lavender) 50%, var(--color-sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.35;
  }

  @keyframes bounce-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(12px); opacity: 0.3; }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Art Commission"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Heading & Running Text",
      "default": "Let Me Draw Your Imagination Into Reality"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "As an artist, I'm here to bring your ideas to life. Let's create something amazing together."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Check My Product"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show Scroll Indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "subheading": "Art Commission",
        "tagline": "Let Me Draw Your Imagination Into Reality",
        "button_label": "Check My Product",
        "show_scroll": true
      }
    }
  ]
}
{% endschema %}
