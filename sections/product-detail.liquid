<section data-gs-section="product-detail" class="relative pt-36 pb-24 px-4" style="background: var(--color-background);">
  <!-- Watercolor wash -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 30% 20%, rgba(196,114,127,0.03) 0%, transparent 50%), radial-gradient(ellipse at 70% 80%, rgba(155,142,196,0.02) 0%, transparent 50%);"></div>

  <div class="relative section-content">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-caption" style="color: var(--color-muted);">
      <a href="/" class="hover:underline">{{ section.settings.breadcrumb_home }}</a>
      <span class="mx-2">/</span>
      <a href="{{ routes.collections_url }}" class="hover:underline">{{ section.settings.breadcrumb_products }}</a>
      <span class="mx-2">/</span>
      <span style="color: var(--color-foreground);">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">
      <!-- LEFT: Product Gallery -->
      <div data-gs="product-gallery">
        <!-- Main Image -->
        <div class="relative rounded-2xl overflow-hidden mb-4" style="background: var(--color-cream); aspect-ratio: 3/4;">
          {% if product.featured_image %}
            <img
              id="product-main-image"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.title }}"
              class="w-full h-full object-cover transition-transform duration-500"
              width="1200"
              height="1500"
            >
          {% else %}
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-24 h-24" style="color: var(--color-muted); opacity: 0.2;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
          {% endif %}

          <!-- Sale badge -->
          {% if product.compare_at_price > product.price %}
            <div class="absolute top-4 left-4 px-3 py-1 rounded-full text-caption font-semibold" style="background: var(--color-blush); color: white;">
              {{ section.settings.sale_badge }}
            </div>
          {% endif %}
        </div>

        <!-- Thumbnails -->
        {% if product.images.size > 1 %}
          <div class="flex gap-2 overflow-x-auto pb-2">
            {% for image in product.images %}
              <button
                onclick="document.getElementById('product-main-image').src='{{ image | image_url: width: 1200 }}'"
                class="shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 transition-all duration-300 product-thumb"
                style="border-color: {% if forloop.first %}var(--color-blush){% else %}transparent{% endif %};"
                data-index="{{ forloop.index0 }}"
              >
                <img src="{{ image | image_url: width: 200 }}" alt="" class="w-full h-full object-cover" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- RIGHT: Product Info -->
      <div class="flex flex-col">
        <!-- Title -->
        <h1 data-gs="product-info" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1;">
          {{ product.title }}
        </h1>

        <!-- Price -->
        <div data-gs="product-info" class="flex items-center gap-3 mb-6">
          <span id="variant-price" class="text-2xl font-semibold" style="color: var(--color-blush);">{{ product.price | money }}</span>
          <span id="variant-compare-at-price" class="text-lg line-through" style="color: var(--color-muted); {% unless product.compare_at_price > product.price %}display: none;{% endunless %}">{{ product.compare_at_price | money }}</span>
          <span id="variant-savings" class="px-2 py-0.5 rounded-full text-caption font-semibold" style="background: rgba(139,170,125,0.1); color: var(--color-sage); {% unless product.compare_at_price > product.price %}display: none;{% endunless %}">
            {% if product.compare_at_price > product.price %}-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%{% endif %}
          </span>
        </div>

        <!-- Description -->
        {% if product.description != blank %}
          <div data-gs="product-info" class="text-body leading-relaxed mb-6" style="color: var(--color-muted);">
            {{ product.description }}
          </div>
        {% endif %}

        <!-- Variant Selector -->
        {% if product.variants.size > 1 %}
          <div data-gs="product-variants" class="mb-8">
            <div class="flex flex-col gap-4">
              {% for option in product.options_with_values %}
                {% assign opt_index = forloop.index0 %}
                <div>
                  <label class="text-body-sm font-medium block mb-2" style="color: var(--color-foreground);">{{ option.name }}</label>
                  <div class="flex flex-wrap gap-2">
                    {% for value in option.values %}
                      {% assign matched_variant = nil %}
                      {% for v in product.variants %}
                        {% if opt_index == 0 and v.option1 == value %}{% assign matched_variant = v %}
                        {% elsif opt_index == 1 and v.option2 == value %}{% assign matched_variant = v %}
                        {% elsif opt_index == 2 and v.option3 == value %}{% assign matched_variant = v %}
                        {% endif %}
                      {% endfor %}
                      <button
                        type="button"
                        class="variant-btn px-4 py-2 rounded-full text-body-sm font-medium transition-all duration-300"
                        data-variant-id="{{ matched_variant.id }}"
                        data-option-name="{{ option.name }}"
                        data-option-value="{{ value }}"
                        {% if matched_variant.id == product.selected_or_first_available_variant.id %}data-active="true" style="background: var(--color-blush); color: white; border-color: var(--color-blush);"{% else %}data-active="false" style="background: var(--color-surface); color: var(--color-foreground); border: 1px solid rgba(45,42,38,0.12);"{% endif %}
                        {% unless matched_variant.available %}disabled style="opacity: 0.4; text-decoration: line-through; background: var(--color-surface); color: var(--color-muted); border: 1px solid rgba(45,42,38,0.08);"{% endunless %}
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Quantity + Add to Cart -->
        <div data-gs="product-actions" class="flex flex-col gap-4 mb-8">
          <!-- Quantity -->
          <div class="flex items-center gap-4">
            <span class="text-body-sm font-medium" style="color: var(--color-foreground);">{{ section.settings.quantity_label }}</span>
            <div class="flex items-center rounded-full overflow-hidden" style="border: 1px solid rgba(45,42,38,0.1);">
              <button onclick="changeQuantity(-1)" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: var(--color-surface);">−</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1" class="w-14 h-10 text-center text-body-sm font-medium border-0 bg-transparent" style="color: var(--color-foreground);">
              <button onclick="changeQuantity(1)" class="w-10 h-10 flex items-center justify-center transition-colors" style="background: var(--color-surface);">+</button>
            </div>
          </div>

          <!-- Variant ID -->
          <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Add to Cart (AJAX) -->
          <form id="product-add-to-cart-form" onsubmit="handleAddToCart(event)">
            <button type="submit" id="add-to-cart-btn" class="btn-primary w-full flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"></path>
              </svg>
              <span>{{ section.settings.add_to_cart_label }}</span>
            </button>
          </form>

          <!-- Buy Now -->
          <a href="{{ routes.cart_url }}" class="btn-secondary w-full flex items-center justify-center gap-2">
            <span>{{ section.settings.buy_now_label }}</span>
          </a>

          <script>
            async function handleAddToCart(e) {
              e.preventDefault();
              var btn = document.getElementById('add-to-cart-btn');
              var variantId = document.getElementById('variant-id').value;
              btn.disabled = true;
              btn.querySelector('span').textContent = 'Adding...';
              try {
                var res = await fetch('/cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: parseInt(variantId), quantity: parseInt(document.getElementById('quantity').value || 1) })
                });
                if (res.ok) {
                  openCartDrawer();
                } else {
                  alert('Could not add item to cart.');
                }
              } catch (err) {
                console.error('Add to cart error:', err);
              }
              btn.disabled = false;
              btn.querySelector('span').textContent = '{{ section.settings.add_to_cart_label }}';
            }
          </script>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-4 mb-6">
          <div class="flex items-center gap-2 text-caption" style="color: var(--color-muted);">
            <svg class="w-4 h-4" style="color: var(--color-sage);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ section.settings.trust_badge_1 }}</span>
          </div>
          <div class="flex items-center gap-2 text-caption" style="color: var(--color-muted);">
            <svg class="w-4 h-4" style="color: var(--color-sage);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ section.settings.trust_badge_2 }}</span>
          </div>
          <div class="flex items-center gap-2 text-caption" style="color: var(--color-muted);">
            <svg class="w-4 h-4" style="color: var(--color-sage);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ section.settings.trust_badge_3 }}</span>
          </div>
        </div>

        <!-- Share -->
        <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid rgba(45,42,38,0.06);">
          <span class="text-caption" style="color: var(--color-muted);">{{ section.settings.share_label }}</span>
          <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}" target="_blank" class="w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
            <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" class="w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
            <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function changeQuantity(delta) {
    var input = document.getElementById('quantity');
    var val = parseInt(input.value) + delta;
    if (val >= 1) input.value = val;
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Variant selector
    var variantBtns = document.querySelectorAll('.variant-btn');
    var variantIdInput = document.getElementById('variant-id');

    // Group buttons by option name
    var optionGroups = {};
    variantBtns.forEach(function(btn) {
      var optName = btn.dataset.optionName;
      if (!optionGroups[optName]) optionGroups[optName] = [];
      optionGroups[optName].push(btn);
    });

    // Selected options state
    var selectedOptions = {};
    variantBtns.forEach(function(btn) {
      if (btn.dataset.active === 'true') {
        selectedOptions[btn.dataset.optionName] = btn.dataset.optionValue;
      }
    });

    variantBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectedOptions[btn.dataset.optionName] = btn.dataset.optionValue;

        // Update visual state for this option group
        optionGroups[btn.dataset.optionName].forEach(function(b) {
          b.style.background = 'var(--color-surface)';
          b.style.color = 'var(--color-foreground)';
          b.style.borderColor = 'rgba(45,42,38,0.12)';
          b.dataset.active = 'false';
        });
        btn.style.background = 'var(--color-blush)';
        btn.style.color = 'white';
        btn.style.borderColor = 'var(--color-blush)';
        btn.dataset.active = 'true';

        // Use Shopify's variant JSON for matching
        var variantData = {{ product.variants | json }};
        var optionNames = {{ product.options | json }};
        var matchingVariantId = null;
        for (var i = 0; i < variantData.length; i++) {
          var v = variantData[i];
          var allMatch = true;
          for (var j = 0; j < optionNames.length; j++) {
            if (selectedOptions[optionNames[j]] && v.options[j] !== selectedOptions[optionNames[j]]) {
              allMatch = false;
              break;
            }
          }
          if (allMatch) {
            matchingVariantId = v.id;
            break;
          }
        }

        if (matchingVariantId) {
          variantIdInput.value = matchingVariantId;
          // Update URL
          window.history.replaceState({}, '', window.location.pathname + '?variant=' + matchingVariantId);

          // Update price
          for (var k = 0; k < variantData.length; k++) {
            if (variantData[k].id === matchingVariantId) {
              var selVariant = variantData[k];
              document.getElementById('variant-price').textContent = (selVariant.price / 100).toLocaleString('en-US', {style: 'currency', currency: '{{ shop.currency }}'});
              var compareEl = document.getElementById('variant-compare-at-price');
              var savingsEl = document.getElementById('variant-savings');
              if (selVariant.compare_at_price && selVariant.compare_at_price > selVariant.price) {
                compareEl.textContent = (selVariant.compare_at_price / 100).toLocaleString('en-US', {style: 'currency', currency: '{{ shop.currency }}'});
                compareEl.style.display = '';
                var sav = Math.round((selVariant.compare_at_price - selVariant.price) * 100 / selVariant.compare_at_price);
                savingsEl.textContent = '-' + sav + '%';
                savingsEl.style.display = '';
              } else {
                compareEl.style.display = 'none';
                savingsEl.style.display = 'none';
              }
              break;
            }
          }
        }
      });
    });

    // Thumbnail click
    document.querySelectorAll('.product-thumb').forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        document.querySelectorAll('.product-thumb').forEach(function(t) {
          t.style.borderColor = 'transparent';
        });
        thumb.style.borderColor = 'var(--color-blush)';
      });
    });
  });
</script>



{% schema %}
{
  "name": "Product Detail",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show Related Products",
      "default": true
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Related Products Collection"
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb: Home",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_products",
      "label": "Breadcrumb: Products",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "breadcrumb_label_fallback",
      "label": "Fallback Label (if no product type)",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "sale_badge",
      "label": "Sale Badge Text",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity Label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to Cart Button",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy Now Button",
      "default": "Buy Now"
    },
    {
      "type": "text",
      "id": "trust_badge_1",
      "label": "Trust Badge 1",
      "default": "Digital Download"
    },
    {
      "type": "text",
      "id": "trust_badge_2",
      "label": "Trust Badge 2",
      "default": "Instant Delivery"
    },
    {
      "type": "text",
      "id": "trust_badge_3",
      "label": "Trust Badge 3",
      "default": "Commercial License"
    },
    {
      "type": "text",
      "id": "share_label",
      "label": "Share Label",
      "default": "Share:"
    },
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Product Detail"
    }
  ]
}
{% endschema %}
