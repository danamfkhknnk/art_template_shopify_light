<section class="relative pt-36 pb-24 px-4" style="background: var(--color-background);">
  <!-- Watercolor wash accent -->
  {% comment %} <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 20% 30%, rgba(196,114,127,0.04) 0%, transparent 50%), radial-gradient(ellipse at 80% 70%, rgba(123,167,194,0.03) 0%, transparent 50%);"></div> {% endcomment %}

  <div class="relative section-content">
    <!-- Product Hero — Services/Products specific -->
    <div class="mb-16 reveal">
      <div class="text-center">
        <p class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
          {{ section.settings.subheading }}
          <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
        </p>
        <h1 class="font-display font-bold mb-4" style="color: var(--color-foreground); font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -0.02em;">
          {{ section.settings.heading }}
        </h1>
        {% if section.settings.description != blank %}
          <p class="text-body-lg max-w-lg mx-auto" style="color: var(--color-muted);">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    </div>

    {% if section.settings.collection != blank %}
      <!-- Gallery-like Grid from Collection -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {% assign products_limit = 50 %}
        {% unless section.settings.show_all %}
          {% assign products_limit = section.settings.products_to_show %}
        {% endunless %}
        {% for product in collections[section.settings.collection].products limit: products_limit %}
          <a href="{{ product.url }}" class="group relative flex flex-col rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-1 reveal" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05); transition-delay: {{ forloop.index | times: 0.05 }}s;">
            <!-- Product Image -->
            <div class="relative aspect-square overflow-hidden">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.title }}"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="w-full h-full flex items-center justify-center" style="background: var(--color-cream);">
                  <svg class="w-16 h-16" style="color: var(--color-muted); opacity: 0.3;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              {% endif %}

              <!-- Price chip -->
              <div class="absolute top-3 right-3 md:top-4 md:right-4 px-3 py-1.5 rounded-full" style="background: rgba(255,255,255,0.9); backdrop-filter: blur(8px); border: 1px solid rgba(45,42,38,0.06);">
                <span class="text-body-sm font-bold" style="color: var(--color-blush);">
                  {% if product.price_min != product.price_max %}
                    {{ product.price_min | money }}+
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </span>
              </div>

              <!-- Hover overlay -->
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: linear-gradient(180deg, transparent 40%, rgba(250,247,242,0.85) 100%);"></div>
              <div class="absolute inset-x-0 bottom-0 flex justify-center pb-5 opacity-0 translate-y-3 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
                <span class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-body-sm font-bold" style="background: var(--color-blush); color: white;">
                  View Product
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
              </div>
            </div>

            <!-- Product Info -->
            <div class="p-4 md:p-5">
              {% if product.type != blank %}
                <p class="text-caption uppercase tracking-wider mb-1" style="color: var(--color-blush);">{{ product.type }}</p>
              {% endif %}
              <h3 class="text-body-lg font-display font-bold truncate" style="color: var(--color-foreground);">{{ product.title }}</h3>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <!-- Fallback: Service cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ section.settings.columns }} gap-6">
        {% for block in section.blocks %}
          {% assign accent_colors = "bg-wc-blush,bg-wc-sky,bg-wc-sage,bg-wc-golden,bg-wc-lavender" | split: "," %}
          {% assign icon_colors = "var(--color-blush),var(--color-sky),var(--color-sage),var(--color-golden),var(--color-lavender)" | split: "," %}
          {% assign idx = forloop.index0 | modulo: 5 %}
          <div class="group watercolor-card p-8 text-center relative overflow-hidden reveal" style="transition-delay: {{ forloop.index | times: 0.1 }}s;" {{ block.shopify_attributes }}>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: linear-gradient(180deg, rgba(196,114,127,0.03) 0%, transparent 100%);"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center transition-all duration-500 {{ accent_colors[idx] }}" style="border: 1px solid rgba(45,42,38,0.06);">
                <svg class="w-8 h-8" style="color: {{ icon_colors[idx] }};" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ block.icon }}"></path>
                </svg>
              </div>
              <h3 class="text-subheading font-display mb-3" style="color: var(--color-foreground);">{{ block.title }}</h3>
              <p class="text-body-sm leading-relaxed mb-4" style="color: var(--color-muted);">{{ block.description }}</p>
              <div class="flex items-center justify-center gap-1 text-caption" style="color: var(--color-blush);">
                <span>Starting from</span>
                <span class="font-semibold text-body-sm">{{ block.price }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div class="text-center mt-12 reveal">
        <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="btn-secondary inline-flex items-center gap-2">
          <span>{{ section.settings.button_label }}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Explore our curated collection of digital art products and templates"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_all",
      "label": "Show all products in collection",
      "default": false
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (fallback)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Portrait"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Detailed character portraits with custom backgrounds"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$50"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "SVG Icon Path",
          "default": "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "Portrait",
            "description": "Detailed character portraits with custom backgrounds",
            "price": "$50"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Character Design",
            "description": "Full character sheets with multiple poses",
            "price": "$120"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Illustration",
            "description": "Full scene illustrations with complex compositions",
            "price": "$200"
          }
        }
      ]
    }
  ]
}
{% endschema %}
