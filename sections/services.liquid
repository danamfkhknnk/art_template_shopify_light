<section data-gs-section="services" class="relative pt-36 pb-24" style="background: var(--bg-services);">
  <!-- Watercolor wash accent -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 20% 30%, rgba(196,114,127,0.04) 0%, transparent 50%), radial-gradient(ellipse at 80% 70%, rgba(123,167,194,0.03) 0%, transparent 50%);"></div>

  <div class="relative section-content px-4">
    <!-- Product Hero — Services/Products specific -->
    <div class="mb-16">
      <div class="text-center">
        <p data-gs="services-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
          {{ section.settings.subheading }}
          <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
        </p>
        <h1 data-gs="services-heading" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: 0.02em;">
          {{ section.settings.heading }}
        </h1>
        {% if section.settings.description != blank %}
          <p data-gs="services-heading" class="text-body-lg max-w-lg mx-auto" style="color: var(--color-muted);">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    </div>

    {% if section.settings.collection != blank %}
      {% assign product_collection = collections[section.settings.collection] %}

      <!-- Tag filter bubbles — every tag used across the collection's products -->
      {% if product_collection.all_tags.size > 0 %}
        <div class="mb-12 flex flex-wrap justify-center gap-3">
          <button data-gs="services-tab" data-filter="all" class="filter-tab active px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300" style="background: var(--color-blush); color: white; border: 1px solid rgba(45,42,38,0.06);">All</button>
          {% for tag in product_collection.all_tags %}
            <button data-gs="services-tab" data-filter="{{ tag | strip | downcase }}" class="filter-tab px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300" style="background: rgba(255,255,255,0.6); color: var(--color-muted); border: 1px solid rgba(45,42,38,0.06);">{{ tag }}</button>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Collection Products — Pinterest-style masonry, sized from each product's real image aspect ratio -->
      <div data-gs="services-grid" class="columns-1 gap-6 sm:columns-2 lg:columns-3">
        {% for product in product_collection.products %}
          {% assign featured_image = product.featured_image %}
          {% assign image_ratio = featured_image.aspect_ratio | default: 1.0 %}
          {% if image_ratio > 1.15 %}
            {% assign orientation = 'Landscape' %}
          {% elsif image_ratio < 0.85 %}
            {% assign orientation = 'Portrait' %}
          {% else %}
            {% assign orientation = 'Square' %}
          {% endif %}

          {% capture product_tag_list %}{% for tag in product.tags %}{{ tag | strip | downcase }}|{% endfor %}{% endcapture %}

          <a
            data-gs="services-card"
            data-tags="{{ product_tag_list }}"
            href="{{ product.url }}"
            class="services-card group mb-6 block break-inside-avoid overflow-hidden rounded-2xl"
            style="background: var(--color-surface); box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.06);"
          >
            <div class="relative overflow-hidden">
              {% if product.images.size > 1 %}
                <div data-slideshow class="relative w-full" style="aspect-ratio: {{ featured_image.width }} / {{ featured_image.height }};">
                  {% for image in product.images %}
                    <img
                      data-slide
                      src="{{ image | image_url: width: 800 }}"
                      alt="{{ product.title }}"
                      class="product-slide product-img absolute inset-0 h-full w-full object-cover{% if forloop.first %} is-active{% endif %}"
                      loading="lazy"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                    >
                  {% endfor %}
                </div>
              {% elsif featured_image %}
                <img
                  src="{{ featured_image | image_url: width: 800 }}"
                  alt="{{ product.title }}"
                  class="product-img block h-auto w-full"
                  loading="lazy"
                  width="{{ featured_image.width }}"
                  height="{{ featured_image.height }}"
                >
              {% else %}
                <div class="flex aspect-square w-full items-center justify-center" style="background: var(--color-cream);">
                  <svg class="h-16 w-16" style="color: var(--color-muted); opacity: 0.3;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              {% endif %}
            </div>

            <div class="p-5">
              {% if product.tags.size > 0 %}
                <p class="mb-2 flex flex-wrap gap-2 text-caption font-medium" style="color: var(--color-blush);">
                  {% for tag in product.tags %}<span>#{{ tag }}</span>{% endfor %}
                </p>
              {% endif %}
              <h3 class="text-subheading font-display mb-1" style="color: var(--color-foreground);">{{ product.title }}</h3>
              <div class="flex items-center justify-between gap-3">
                <span class="text-body font-bold" style="color: var(--color-foreground);">
                  {% if product.price_varies %}Start from {{ product.price_min | money }}{% else %}{{ product.price | money }}{% endif %}
                </span>
                <span class="view-link inline-flex items-center gap-1.5 text-body-sm font-bold" style="color: var(--color-blush);">
                  View Detail
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
      <script>
        (function () {
          var section = document.currentScript.closest('[data-gs-section="services"]');
          if (!section) return;

          var slideshows = section.querySelectorAll('[data-slideshow]');
          slideshows.forEach(function (el) {
            var slides = Array.prototype.slice.call(el.querySelectorAll('[data-slide]'));
            if (slides.length < 2) return;

            var current = 0;
            setInterval(function () {
              slides[current].classList.remove('is-active');
              current = (current + 1) % slides.length;
              slides[current].classList.add('is-active');
            }, 3200);
          });

          /* Tag filter bubbles */
          var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-gs="services-tab"]'));
          var cards = Array.prototype.slice.call(section.querySelectorAll('[data-gs="services-card"]'));
          tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
              var filter = tab.dataset.filter;

              tabs.forEach(function (t) {
                t.classList.remove('active');
                t.style.background = 'rgba(255,255,255,0.6)';
                t.style.color = 'var(--color-muted)';
                t.style.border = '1px solid rgba(45,42,38,0.06)';
              });
              tab.classList.add('active');
              tab.style.background = 'var(--color-blush)';
              tab.style.color = 'white';
              tab.style.border = 'none';

              cards.forEach(function (card) {
                var tags = (card.dataset.tags || '').split('|');
                var matches = filter === 'all' || tags.indexOf(filter) !== -1;

                /* GSAP loads at the end of <body>, after this inline script,
                   so its availability is only checked here (at click time,
                   long after it has loaded) rather than at setup time. */
                if (typeof gsap === 'undefined') {
                  card.style.display = matches ? 'block' : 'none';
                  return;
                }

                if (matches) {
                  card.style.display = 'block';
                  gsap.to(card, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' });
                } else {
                  gsap.to(card, {
                    opacity: 0, scale: 0.95, duration: 0.3, ease: 'power2.in',
                    onComplete: function () { card.style.display = 'none'; }
                  });
                }
              });
            });
          });
        })();
      </script>
    {% else %}
      <!-- Fallback: Service cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ section.settings.columns }} gap-6">
        {% for block in section.blocks %}
          {% assign accent_colors = "bg-wc-blush,bg-wc-sky,bg-wc-sage,bg-wc-golden,bg-wc-lavender" | split: "," %}
          {% assign icon_colors = "var(--color-blush),var(--color-sky),var(--color-sage),var(--color-golden),var(--color-lavender)" | split: "," %}
          {% assign idx = forloop.index0 | modulo: 5 %}
          <div data-gs="services-card" class="group watercolor-card p-8 text-center relative overflow-hidden" style="transition-delay: {{ forloop.index | times: 0.1 }}s;" {{ block.shopify_attributes }}>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: linear-gradient(180deg, rgba(196,114,127,0.03) 0%, transparent 100%);"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center transition-all duration-500 {{ accent_colors[idx] }}" style="border: 1px solid rgba(45,42,38,0.06);">
                <svg class="w-8 h-8" style="color: {{ icon_colors[idx] }};" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ block.icon }}"></path>
                </svg>
              </div>
              <h3 class="text-subheading font-display mb-3" style="color: var(--color-foreground);">{{ block.title }}</h3>
              <p class="text-body-sm leading-relaxed mb-4" style="color: var(--color-muted);">{{ block.description }}</p>
              <div class="flex items-center justify-center gap-1 text-caption" style="color: var(--color-blush);">
                <span>Starting from</span>
                <span class="font-semibold text-body-sm">{{ block.price }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div class="text-center mt-12">
        <a data-gs="services-btn" href="{{ section.settings.button_link | default: routes.collections_url }}" class="btn-secondary inline-flex items-center gap-2">
          <span>{{ section.settings.button_label }}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* === Smooth Hover Effects (cubic-bezier: easeOutExpo, unified across the card) === */

  /* Card lift + shadow grow */
  [data-gs="services-card"] {
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  [data-gs="services-card"]:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
  }

  /* Masonry product image zoom (kept at its natural aspect ratio, not cropped) */
  .product-img {
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  [data-gs="services-card"]:hover .product-img {
    transform: scale(1.06);
  }

  /* Multi-image products: auto-cycle by crossfading — the current photo
     fades out while the next fades in over it, replacing it in place.
     Not a slider: nothing moves horizontally. */
  .product-slide {
    opacity: 0;
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-slide.is-active {
    opacity: 1;
  }

  .view-link {
    transition: gap 0.6s cubic-bezier(0.16, 1, 0.3, 1), color 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-gs="services-card"]:hover .view-link {
    gap: 0.75rem;
  }
</style>

{% schema %}
{
  "name": "Services",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Service"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Find Best You Need!"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "select",
      "id": "columns",
      "label": "Columns (fallback)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Portrait"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Detailed character portraits with custom backgrounds"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$50"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "SVG Icon Path",
          "default": "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "Portrait",
            "description": "Detailed character portraits with custom backgrounds",
            "price": "$50"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Character Design",
            "description": "Full character sheets with multiple poses",
            "price": "$120"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Illustration",
            "description": "Full scene illustrations with complex compositions",
            "price": "$200"
          }
        }
      ]
    }
  ]
}
{% endschema %}
