<main style="padding-top: 100px;">
  <section class="relative py-20 px-4">
    <div class="section-content">
      <h1 style="font-size: 1.8rem; font-weight: 600; text-align: center; margin-bottom: 2rem; color: var(--color-contact);">Shopping Cart</h1>

      <form action="{{ routes.cart_url }}" method="post" style="max-width: 700px; margin: 0 auto;">
        {% if cart.item_count > 0 %}
          <table style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="border-bottom: 1px solid rgba(45,42,38,0.08);">
                <th style="text-align: left; padding: 12px 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); font-weight: 500;">Product</th>
                <th style="text-align: center; padding: 12px 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); font-weight: 500;">Qty</th>
                <th style="text-align: right; padding: 12px 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); font-weight: 500;">Total</th>
              </tr>
            </thead>
            <tbody>
              {% for item in cart.items %}
                <tr style="border-bottom: 1px solid rgba(45,42,38,0.05);">
                  <td style="padding: 16px 0;">
                    <div style="display: flex; gap: 14px; align-items: center;">
                      {% if item.image %}
                        <div style="width: 64px; height: 64px; border-radius: 10px; overflow: hidden; flex-shrink: 0;">
                          <img src="{{ item.image | image_url: width: 128 }}" alt="{{ item.title }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="64" height="64">
                        </div>
                      {% endif %}
                      <div>
                        <p style="font-size: 0.85rem; font-weight: 500; margin: 0; color: var(--color-foreground);">{{ item.product.title }}</p>
                        {% if item.variant_title %}
                          <p style="font-size: 0.72rem; margin: 2px 0 0; color: var(--color-muted);">{{ item.variant_title }}</p>
                        {% endif %}
                        <a href="{{ item.url_to_remove }}" style="font-size: 0.72rem; color: var(--color-blush); text-decoration: none; opacity: 0.7;">Remove</a>
                      </div>
                    </div>
                  </td>
                  <td style="text-align: center; padding: 16px 0;">
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                      style="width: 56px; text-align: center; padding: 6px; border-radius: 8px; border: 1px solid rgba(45,42,38,0.1); font-size: 0.85rem; background: white;">
                  </td>
                  <td style="text-align: right; padding: 16px 0; font-size: 0.9rem; font-weight: 500; color: var(--color-foreground);">
                    {{ item.final_line_price | money }}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 24px; border-top: 1px solid rgba(45,42,38,0.08);">
            <input type="submit" name="update" value="Update Cart"
              style="padding: 10px 20px; border-radius: 10px; border: 1px solid rgba(45,42,38,0.1); background: white; font-size: 0.8rem; cursor: pointer; color: var(--color-foreground);">
            <div style="text-align: right;">
              <p style="font-size: 0.8rem; color: var(--color-muted); margin: 0;">Subtotal</p>
              <p style="font-size: 1.2rem; font-weight: 600; margin: 4px 0 0; color: var(--color-foreground);">{{ cart.total_price | money }}</p>
            </div>
          </div>

          <div style="text-align: right; margin-top: 20px;">
            <input type="submit" name="checkout" value="Checkout"
              style="padding: 14px 40px; border-radius: 12px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em; cursor: pointer; background: var(--color-foreground); color: var(--color-background); border: none; transition: opacity 0.3s;"
              onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
          </div>
        {% else %}
          <div style="text-align: center; padding: 60px 20px; color: var(--color-muted);">
            <p style="font-size: 1rem; margin: 0 0 8px;">Your cart is empty</p>
            <a href="{{ routes.all_products_collection_url }}" style="font-size: 0.85rem; color: var(--color-blush); text-decoration: none;">Continue Shopping</a>
          </div>
        {% endif %}
      </form>
    </div>
  </section>
</main>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
