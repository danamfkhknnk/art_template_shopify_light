{% comment %}
  Password landing page shown when store password protection is enabled.
  Styled to match the site branding. The store password can be shown as a
  hint and pre-filled into the input via section settings.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{% assign pw_value = section.settings.store_password | default: 'password' %}

<div class="min-h-screen flex items-center justify-center px-6 py-16" style="background: var(--gradient-warm);">
  <div
    class="w-full max-w-md text-center rounded-2xl p-6"
    style="background: var(--color-surface); box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.06);"
  >
    <p class="text-caption tracking-[0.25em] uppercase font-medium mb-3" style="color: var(--color-blush);">
      {{ section.settings.eyebrow | default: 'My Work' }}
    </p>

    <h1 class="font-display mb-3" style="color: var(--color-foreground); font-size: clamp(2rem, 5vw, 2.75rem); letter-spacing: 0.02em;">
      {{ section.settings.heading | default: 'Come Take a Look' }}
    </h1>

    <p class="text-body-sm mb-6" style="color: var(--color-muted);">
      {{ section.settings.subtext | default: "Here's a closer look at the projects I've built and the ideas I've brought to life." }}
    </p>

    {% if section.settings.show_hint %}
      <p class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-caption font-medium mb-6" style="background: var(--color-cream); color: var(--color-foreground); border: 1px dashed var(--color-blush);">
        <span style="color: var(--color-muted);">Store password:</span>
        <strong>{{ pw_value }}</strong>
        <button
          type="button"
          id="password-copy"
          class="underline underline-offset-2"
          style="color: var(--color-blush);"
          data-copy="{{ pw_value | escape }}"
        >
          Copy
        </button>
      </p>
    {% endif %}

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="rounded-lg px-4 py-3 text-body-sm mb-4" style="background: #fdecec; color: #b3261e; border: 1px solid #f5c6c2;">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <label for="password-input" class="block text-left text-caption font-medium tracking-wide mb-2" style="color: var(--color-foreground);">
        {{ 'password.password' | t }}
      </label>

      <div class="relative mb-4">
        <input
          type="password"
          name="password"
          id="password-input"
          autocomplete="current-password"
          autofocus
          {% if section.settings.prefill %}value="{{ pw_value | escape }}"{% endif %}
          class="block w-full rounded-xl px-4 py-3 text-body-sm pr-16"
          style="background: var(--color-background); color: var(--color-foreground); border: 1px solid rgba(45,42,38,0.15); outline: none; height: 52px; min-height: 0;"
          onfocus="this.style.borderColor='var(--color-blush)'"
          onblur="this.style.borderColor='rgba(45,42,38,0.15)'"
        >
        <button
          type="button"
          id="password-toggle"
          class="text-caption font-medium"
          style="color: var(--color-blush); position: absolute; right: 12px; top: 50%; transform: translateY(-50%); line-height: 1;"
        >
          Show
        </button>
      </div>

      <button
        type="submit"
        class="block w-full rounded-full px-6 py-4 text-body-sm font-bold tracking-wide transition-transform duration-300 hover:scale-[1.02]"
        style="background: var(--gradient-primary); color: #fff; box-shadow: var(--shadow-accent);"
      >
        {{ 'password.enter' | t }}
      </button>
    {% endform %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('password-input');
    var toggle = document.getElementById('password-toggle');
    var copy = document.getElementById('password-copy');

    if (toggle && input) {
      toggle.addEventListener('click', function() {
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        toggle.textContent = show ? 'Hide' : 'Show';
        input.focus();
      });
    }

    if (copy && input) {
      copy.addEventListener('click', function() {
        var val = copy.getAttribute('data-copy') || '';
        input.value = val;
        if (navigator.clipboard) {
          navigator.clipboard.writeText(val).catch(function() {});
        } else {
          input.type = 'text';
          input.select();
          try { document.execCommand('copy'); } catch (e) {}
          input.type = 'password';
        }
        copy.textContent = 'Copied!';
        setTimeout(function() { copy.textContent = 'Copy'; }, 1500);
        input.focus();
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "My Work"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Come Take a Look"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Here's a closer look at the projects I've built and the ideas I've brought to life."
    },
    {
      "type": "text",
      "id": "store_password",
      "label": "Store password (shown as hint and pre-filled)",
      "default": "password"
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "Show password hint text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "prefill",
      "label": "Pre-fill the password input",
      "default": true
    }
  ]
}
{% endschema %}
