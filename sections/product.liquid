<section class="relative pt-32 pb-20 px-4" style="background: var(--color-background);">
  <div class="relative section-content">
    {% if section.settings.heading != blank %}
      <div class="text-center mb-12">
        <p class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2 reveal" style="color: var(--color-blush);">
          <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
          {{ section.settings.subheading }}
          <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
        </p>
        <h2 class="text-heading font-display reveal reveal-delay-1" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{{ section.settings.columns }} gap-6">
      {% for block in section.blocks %}
        <div class="group watercolor-card overflow-hidden reveal" style="transition-delay: {{ forloop.index | times: 0.1 }}s;" {{ block.shopify_attributes }}>
          <div class="aspect-square overflow-hidden">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="w-full h-full flex items-center justify-center" style="background: var(--color-cream);">
                <svg class="w-16 h-16" style="color: var(--color-muted); opacity: 0.3;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            {% endif %}
          </div>
          <div class="p-5">
            {% if block.settings.title != blank %}
              <h3 class="text-body-lg font-display font-bold mb-2" style="color: var(--color-foreground);">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="text-body-sm leading-relaxed mb-4" style="color: var(--color-muted);">{{ block.settings.description }}</p>
            {% endif %}
            <div class="flex items-center justify-between">
              {% if block.settings.price != blank %}
                <p class="text-body-lg font-semibold" style="color: var(--color-blush);">{{ block.settings.price }}</p>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a href="{{ block.settings.button_link }}" class="text-body-sm font-medium transition-colors duration-300" style="color: var(--color-muted);">
                  {{ block.settings.button_label }} →
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Art Print"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "High quality art print on premium paper."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$29.99"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "View Details"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "title": "Art Print - Sunset",
            "description": "High quality art print on premium paper.",
            "price": "$29.99",
            "button_label": "View Details"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Art Print - Portrait",
            "description": "Custom portrait print from your photos.",
            "price": "$49.99",
            "button_label": "View Details"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Art Print - Character",
            "description": "Original character design print.",
            "price": "$39.99",
            "button_label": "View Details"
          }
        }
      ]
    }
  ]
}
{% endschema %}
