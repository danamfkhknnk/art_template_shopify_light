<section data-gs-section="addons" class="relative py-20 px-4" style="background: var(--bg-addons);">
  <!-- Watercolor wash -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 50% 30%, rgba(196,162,101,0.04) 0%, transparent 50%);"></div>

  <div class="relative section-content max-w-4xl mx-auto">
    <!-- Heading -->
    <div class="text-center mb-12">
      <p data-gs="addons-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-golden);">
        <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-golden));"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-golden));"></span>
      </p>
      <h2 data-gs="addons-heading" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(1.8rem, 3vw, 2.5rem);">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.description != blank %}
        <p data-gs="addons-heading" class="text-body-lg max-w-lg mx-auto" style="color: var(--color-muted);">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <!-- Add-ons Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for block in section.blocks %}
        {% if block.type == 'addon' %}
          <div data-gs="addons-card" class="watercolor-card p-6 text-center group" {{ block.shopify_attributes }}>
            <!-- Icon -->
            <div class="w-14 h-14 mx-auto mb-4 rounded-full flex items-center justify-center transition-all duration-500" style="background: rgba(196,162,101,0.08); border: 1px solid rgba(196,162,101,0.15);">
              {% if block.settings.icon != blank %}
                <svg class="w-7 h-7" style="color: var(--color-golden);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ block.settings.icon }}"></path>
                </svg>
              {% else %}
                <svg class="w-7 h-7" style="color: var(--color-golden);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
              {% endif %}
            </div>

            <!-- Title -->
            <h3 class="font-display mb-2" style="color: var(--color-foreground);">{{ block.settings.title }}</h3>

            <!-- Description -->
            {% if block.settings.description != blank %}
              <p class="text-body-sm leading-relaxed mb-4" style="color: var(--color-muted);">{{ block.settings.description }}</p>
            {% endif %}

            <!-- Price -->
            <div class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full" style="background: rgba(196,162,101,0.08); border: 1px solid rgba(196,162,101,0.15);">
              <span class="text-body-sm font-semibold" style="color: var(--color-golden);">{{ block.settings.price }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- CTA -->
    {% if section.settings.button_label != blank %}
      <div class="text-center mt-12">
        <a href="{{ section.settings.button_link }}" class="btn-primary inline-flex items-center gap-2">
          <span>{{ section.settings.button_label }}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
