<section data-gs-section="faq-page" class="relative pt-36 pb-24 px-4" style="background: var(--color-contact);">
  <!-- Watercolor wash accent -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 70% 10%, rgba(155,142,196,0.04) 0%, transparent 50%), radial-gradient(ellipse at 20% 70%, rgba(196,114,127,0.03) 0%, transparent 50%);"></div>

  <div class="relative section-content max-w-4xl mx-auto">
    <!-- Page Heading -->
    <div class="text-center mb-16">
      <p data-gs="faq-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
        <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
      </p>
      <h1 data-gs="faq-heading" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: 0.02em;">
        {{ section.settings.heading }}
      </h1>
      {% if section.settings.description != blank %}
        <p data-gs="faq-heading" class="text-body-lg max-w-lg mx-auto" style="color: var(--color-muted);">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <!-- Category Groups -->
    <div class="space-y-16">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <!-- Category Header -->
          <div data-gs="faq-category" {{ block.shopify_attributes }}>
            <div class="flex items-center gap-4 mb-6">

              <h2 class="text-subheading font-display" style="color: var(--color-foreground);">{{ block.settings.category_title }}</h2>
              <div class="flex-1 h-px" style="background: linear-gradient(to right, rgba(196,114,127,0.25), transparent);"></div>
            </div>

            <!-- FAQ Items in this category -->
            <div class="flex flex-col gap-3">
              {% for inner_block in section.blocks %}
                {% if inner_block.type == 'question' and inner_block.settings.category == block.settings.category_key %}

                  {% assign is_open = section.settings.open_by_default %}
                   <div class="watercolor-card overflow-hidden faq-page-item" {{ inner_block.shopify_attributes }}>
                     <button class="faq-page-toggle w-full flex items-start justify-between gap-4 p-6 text-left transition-colors duration-300" style="background: transparent;">                        
                      <span class="flex items-start gap-0">
                         <span class="text-body font-medium" style="color: var(--color-foreground);">{{ inner_block.settings.question }}</span>
                       </span>
                       <svg class="w-5 h-5 shrink-0 faq-page-icon transition-transform duration-300 mt-0.5 {% if is_open %}rotate-180{% endif %}" style="color: var(--color-blush);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                       </svg>
                     </button>
                     <div class="faq-page-content {% if is_open %}max-h-[1000px]{% else %}max-h-0{% endif %} overflow-hidden transition-all duration-500">
                       <div class="px-6 pb-6 text-body-sm leading-relaxed" style="color: var(--color-muted); border-top: 1px solid rgba(45,42,38,0.06); padding-top: 1rem;">
                         {{ inner_block.settings.answer }}
                       </div>
                     </div>
                   </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Bottom CTA -->
    {% if section.settings.cta_label != blank %}
      <div class="text-center mt-10">
        <p class="text-body mb-6" style="color: var(--color-muted);">{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_link }}" class="btn-primary inline-flex items-center gap-2">
          <span>{{ section.settings.cta_label }}</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.faq-page-toggle').forEach(function(toggle) {
      var content = toggle.nextElementSibling;
      var icon = toggle.querySelector('.faq-page-icon');
      var isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
      if (isOpen) {
        icon.style.transform = 'rotate(180deg)';
      }

      toggle.addEventListener('click', function() {
        isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
        } else {
          content.style.maxHeight = '0px';
          icon.style.transform = 'rotate(0deg)';
        }
      });
    });
  });
</script>

<style>
  .faq-page-toggle:hover .faq-page-icon {
    transform: translateY(2px);
  }
  .faq-page-item .faq-page-icon {
    transition: transform 0.3s ease;
  }
</style>

{% schema %}
{
  "name": "FAQ Page",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Quick answers to get you started."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Still have questions? Reach out and we'll get back to you as soon as possible."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open all items by default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "Category Title",
          "default": "General"
        },
        {
          "type": "text",
          "id": "category_key",
          "label": "Category Key",
          "info": "Unique identifier to link questions to this category. Example: general",
          "default": "general"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category Key",
          "info": "Must match the Category Key of the category this question belongs to. Example: general",
          "default": "general"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why should I commission this studio?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We specialize in VTuber model creation and custom illustrations, offering high-quality results at budget-friendly prices.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "category_title": "General",
            "category_key": "general"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "general",
            "question": "Why should I commission this studio?",
            "answer": "<p>We specialize in VTuber model creation and custom illustrations, offering high-quality results at budget-friendly prices. Our team of experienced artists is at your service.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "general",
            "question": "How do I start a project?",
            "answer": "<p>Simply contact us through the Contact section and ask for a quotation.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "general",
            "question": "Is there any form to fill in for commissions?",
            "answer": "<p>Once you placed the order, a requirement list would be sent for you to fill in.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Price and Payments",
            "category_key": "pricing"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "pricing",
            "question": "How much do your services cost?",
            "answer": "<p>Our pricing is detailed in our Price List section. If you have a specific project in mind, feel free to contact us for a custom quote.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "pricing",
            "question": "What payment methods do you accept?",
            "answer": "<p>We accept payments via PayPal, or you can place your order on our Fiverr and VGen page.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "pricing",
            "question": "Do you offer payment plans?",
            "answer": "<p>We prefer all payments are made in full upfront, but for clients with special needs, we do offer a two-part payment plan: 50% upfront to place the order and 50% before rigging begins.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Packages and Services",
            "category_key": "packages"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "packages",
            "question": "What's included in a VTuber model package?",
            "answer": "<p>Our VTuber packages typically include a fully rigged model, optional poses and expression toggles, and custom designs tailored to your specifications.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "packages",
            "question": "Can I request a certain artist and rigger for my model?",
            "answer": "<p>We assign the artists and riggers based on their availability and their specialities. Clients who want to select specific artists or riggers may incur additional fees and longer wait times.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "packages",
            "question": "Do you offer art only or rig only commissions?",
            "answer": "<p>We currently don't accept art-only or rig-only commissions, as we focus on providing complete art + rig packages to ensure the best quality and consistency.</p>"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Others",
            "category_key": "others"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "others",
            "question": "How long does it take to create a VTuber model?",
            "answer": "<p>Please check our Queue Time section for reference.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "others",
            "question": "Do you offer fast delivery?",
            "answer": "<p>No, we don't.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "others",
            "question": "What happens after I place the order?",
            "answer": "<p>Our project manager would be communicating with you on your preferred platform as a bridge between you and the assigned artist and rigger for updates and feedback.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "others",
            "question": "Can I request revisions on my VTuber model?",
            "answer": "<p>Yes! We offer revisions during the design and rigging phases. Please check our process of work on our TOS section for reference.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
