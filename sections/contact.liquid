<section data-gs-section="contact" id="contact" class="relative py-36 px-4" style="background: var(--bg-contact); scroll-margin-top: 120px;">
  <div id="contact_form" class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 50% 30%, rgba(196,114,127,0.04) 0%, transparent 50%);"></div>

  <div class="relative section-content max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <p data-gs="contact-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
        <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
      </p>
      <h2 data-gs="contact-heading" class="text-heading font-display mb-4" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
      <p data-gs="contact-heading" class="text-body-lg max-w-lg mx-auto" style="color: var(--color-muted);">
        {{ section.settings.description }}
      </p>
    </div>

    <div data-gs="contact-form" class="watercolor-card p-8 md:p-10">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div data-contact-result="success" class="p-4 rounded-xl mb-6 text-body-sm text-center" style="background: rgba(107,158,107,0.08); border: 1px solid rgba(107,158,107,0.15); color: var(--color-success);">
            {{ section.settings.success_message }}
          </div>
        {% endif %}
        {% if form.errors %}
          <div data-contact-result="error" class="p-4 rounded-xl mb-6 text-body-sm" style="background: rgba(196,114,127,0.06); border: 1px solid rgba(196,114,127,0.12); color: var(--color-blush);">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div data-gs="contact-field">
            <label class="block text-caption font-medium mb-2 uppercase tracking-wider" style="color: var(--color-muted);">{{ section.settings.label_name }}</label>
            <input type="text" name="contact[name]" placeholder="{{ section.settings.placeholder_name }}" class="w-full px-4 py-3 rounded-xl text-body-sm" style="background: var(--color-cream); border: 1px solid rgba(45,42,38,0.08); color: var(--color-foreground); transition: all 0.3s ease;" required>
          </div>
          <div data-gs="contact-field">
            <label class="block text-caption font-medium mb-2 uppercase tracking-wider" style="color: var(--color-muted);">{{ section.settings.label_email }}</label>
            <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder_email }}" class="w-full px-4 py-3 rounded-xl text-body-sm" style="background: var(--color-cream); border: 1px solid rgba(45,42,38,0.08); color: var(--color-foreground); transition: all 0.3s ease;" required>
          </div>
        </div>

        <div data-gs="contact-field" class="mb-6">
          <label class="block text-caption font-medium mb-2 uppercase tracking-wider" style="color: var(--color-muted);">{{ section.settings.label_message }}</label>
          <textarea name="contact[body]" placeholder="{{ section.settings.placeholder_message }}" rows="5" class="w-full px-4 py-3 rounded-xl text-body-sm resize-none" style="background: var(--color-cream); border: 1px solid rgba(45,42,38,0.08); color: var(--color-foreground); transition: all 0.3s ease;" required></textarea>
        </div>

        <button data-gs="contact-submit" type="submit" class="btn-primary w-full md:w-auto">
          <span>{{ section.settings.button_label }}</span>
        </button>
      {% endform %}
    </div>
  </div>

</section>

<script>
  (function () {
    var section = document.querySelector('[data-gs-section="contact"]');
    if (!section) return;

    var form = section.querySelector('form');
    var submitBtn = section.querySelector('[data-gs="contact-submit"]');
    var submitLabel = submitBtn ? submitBtn.querySelector('span') : null;
    if (!form) return;

    form.addEventListener('submit', function () {
      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Sending...';
    });
  })();
</script>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ask Me Anything"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We Were To Help"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for your message! I'll get back to you soon."
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Label: Name",
      "default": "Your Name"
    },
    {
      "type": "text",
      "id": "placeholder_name",
      "label": "Placeholder: Name",
      "default": "John Doe"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Label: Email",
      "default": "Your Email"
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Placeholder: Email",
      "default": "john@example.com"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Label: Message",
      "default": "Your Message"
    },
    {
      "type": "text",
      "id": "placeholder_message",
      "label": "Placeholder: Message",
      "default": "Tell me anything"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@example.com"
    },
    {
      "type": "text",
      "id": "discord",
      "label": "Discord Invite Link",
      "default": "#"
    },
    {
      "type": "text",
      "id": "discord_name",
      "label": "Discord Name",
      "default": "username"
    }
  ],
  "presets": [
    {
      "name": "Contact",
      "settings": {
        "subheading": "Contact",
        "heading": "Get In Touch",
        "description": "Have a project in mind? I'd love to hear about it. Let's create something beautiful together.",
        "success_message": "Thank you for your message! I'll get back to you soon.",
        "label_name": "Your Name",
        "placeholder_name": "John Doe",
        "label_email": "Your Email",
        "placeholder_email": "john@example.com",
        "label_message": "Your Message",
        "placeholder_message": "Tell me about your project, timeline, and any ideas you have in mind...",
        "button_label": "Send Message",
      }
    }
  ]
}
{% endschema %}
