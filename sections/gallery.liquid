          <img src="{{ 'gallery6.jpg' | asset_url }}" alt="Enchanted Forest" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: linear-gradient(180deg, transparent 40%, rgba(250,247,242,0.9) 100%);"></div>
