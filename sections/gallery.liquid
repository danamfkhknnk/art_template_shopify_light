<section data-gs-section="gallery" class="relative pt-36 pb-24 px-4" style="background: var-(--bg-contact)"> 
  <!-- Watercolor wash background -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 70% 20%, rgba(155,142,196,0.04) 0%, transparent 50%), radial-gradient(ellipse at 30% 80%, rgba(196,162,101,0.03) 0%, transparent 50%);"></div>

  <div class="relative section-content">
    <!-- Artwork Strip Hero — Gallery specific -->
    <div class="mb-16">
      <div class="text-center">
        <p data-gs="gallery-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
          {{ section.settings.subheading }}
          <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
        </p>
        <h1 data-gs="gallery-heading" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: 0.02em;">
          {{ section.settings.heading }}
        </h1>
        <p data-gs="gallery-heading" class="text-body-lg max-w-md mx-auto" style="color: var(--color-muted);">{{ section.settings.description }}</p>
      </div>
    </div>

    {% comment %} <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {% assign filter_tabs = section.settings.filter_tabs | split: "," %}
      {% for tab in filter_tabs %}
        <button data-gs="gallery-tab" data-filter="{{ tab | strip | downcase }}" class="filter-tab {% if forloop.first %}active{% endif %} px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300" style="background: {% if forloop.first %}var(--color-blush){% else %}rgba(255,255,255,0.6){% endif %}; color: {% if forloop.first %}white{% else %}var(--color-muted){% endif %}; border: 1px solid rgba(45,42,38,0.06);">{{ tab | strip }}</button>
      {% endfor %}
    </div> {% endcomment %}

    <!-- Masonry board (VGen-style): card height follows each artwork's real
         aspect ratio instead of a fixed crop, so tall/wide/square pieces all
         sit naturally and the board reads as an organic, varied wall.
         Data sources: Hero Metaobjects + Gallery Metaobjects (curated
         artwork) plus every image of every product in the chosen
         collection, so real product artwork fills out the gallery too. -->
    {% assign hero_items = shop.metaobjects.hero.values %}
    {% assign gallery_items = shop.metaobjects.gallery.values %}
    {% if section.settings.collection != blank %}
      {% assign product_collection = collections[section.settings.collection] %}
    {% endif %}

    <div class="relative" id="gallery-masonry">
      {% for item in hero_items %}
        {% if item.img %}
          {% assign item_ratio = item.img.aspect_ratio | default: item.img.preview_image.aspect_ratio %}
          {% assign item_width = item.img.width | default: item.img.preview_image.width %}
          {% assign item_height = item.img.height | default: item.img.preview_image.height %}
          <div data-gs="gallery-item" class="gallery-item absolute top-0 left-0" data-category="{{ item.category | default: 'all' }}" data-ratio="{{ item_ratio }}">
            <button type="button" class="group relative block w-full cursor-pointer overflow-hidden rounded-md transition-all duration-500" data-title="{{ item.title | escape }}" style="background: var(--color-surface); box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
              <img
                src="{{ item.img | image_url: width: 800 }}"
                alt="{{ item.img.alt | default: 'Gallery artwork' }}"
                class="block w-full h-auto transition-transform duration-700 group-hover:scale-105"
                width="{{ item_width }}"
                height="{{ item_height }}"
              >
            </button>
          </div>
        {% endif %}
      {% endfor %}

      {% for item in gallery_items %}
        {% if item.img %}
          {% assign item_ratio = item.img.aspect_ratio | default: item.img.preview_image.aspect_ratio %}
          <div data-gs="gallery-item" class="gallery-item absolute top-0 left-0" data-category="{{ item.category | default: 'all' }}" data-ratio="{{ item_ratio }}">
            <button type="button" class="group relative block w-full cursor-pointer overflow-hidden rounded-md transition-all duration-500" data-title="{{ item.title | escape }}" style="background: var(--color-surface); box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
              <img
                src="{{ item.img | image_url: width: 800 }}"
                alt="{{ item.title | default: 'Gallery artwork' | escape }}"
                class="block w-full h-auto transition-transform duration-700 group-hover:scale-105"
              >
            </button>
          </div>
        {% endif %}
      {% endfor %}

      {% if product_collection %}
        {% for product in product_collection.products %}
          {% assign product_category = product.type | default: 'all' | strip | downcase %}
          {% for image in product.images %}
            <div data-gs="gallery-item" class="gallery-item absolute top-0 left-0" data-category="{{ product_category }}" data-ratio="{{ image.aspect_ratio }}">
              <button type="button" class="group relative block w-full cursor-pointer overflow-hidden rounded-md transition-all duration-500" data-title="{{ product.title | escape }}" style="background: var(--color-surface); box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  class="block w-full h-auto transition-transform duration-700 group-hover:scale-105"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                >
              </button>
            </div>
          {% endfor %}
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="gallery-lightbox" class="fixed inset-0 z-[10000] hidden items-center justify-center p-4" style="background: rgba(250,247,242,0.95); backdrop-filter: blur(12px); opacity:0;transition:opacity .3s ease;" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);" aria-label="Close">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <button id="lightbox-prev" class="absolute left-2 md:left-4 z-10 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);" aria-label="Previous">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
    </button>
    <button id="lightbox-next" class="absolute right-2 md:right-4 z-10 w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);" aria-label="Next">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </button>
    <figure id="lightbox-figure" class="flex flex-col items-center max-w-[92vw] md:max-w-4xl translate-y-16 scale-95 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-md" style="box-shadow: 0 16px 64px rgba(45,42,38,0.12); border: 1px solid rgba(45,42,38,0.06);">
      <figcaption class="mt-4 text-center">
        <p id="lightbox-category" class="text-caption uppercase tracking-wider" style="color: var(--color-blush);"></p>
        <h3 id="lightbox-title" class="text-subheading font-display mt-1" style="color: var(--color-foreground);"></h3>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var lightbox = document.getElementById('gallery-lightbox');
    var lightboxFigure = document.getElementById('lightbox-figure');
    var lightboxImg = document.getElementById('lightbox-img');
    var lightboxTitle = document.getElementById('lightbox-title');
    var lightboxCategory = document.getElementById('lightbox-category');
    var tabs = document.querySelectorAll('.filter-tab');
    var items = document.querySelectorAll('.gallery-item');
    var masonry = document.getElementById('gallery-masonry');
    var visibleItems = [];
    var currentIndex = 0;
    var lightboxOpen = false;

    // True JS-driven masonry: each item is absolutely positioned into the
    // shortest column, like a real masonry wall, instead of relying on the
    // CSS `columns` balancing algorithm. That's necessary because CSS column
    // balancing doesn't let us see or control which items end up stacked
    // directly on top of each other in a column — it can (and did) put two
    // images of near-identical size/shape back to back, which reads as a
    // repeated, un-random block instead of an organic wall.
    var GAP = 16; // matches the previous gap-4

    // Two ratios "look the same" if they're within 15% of each other —
    // finer than a broad portrait/landscape/square bucket, since e.g. two
    // different 16:9-ish landscape images can still both read as
    // "landscape" yet look distinctly different in practice, while two
    // near-identical ratios (like a product's front/back shots) are what
    // actually reads as a repeated, un-random block when stacked.
    var ratiosLookSimilar = function(a, b) {
      if (!a || !b) return false;
      return Math.abs(a - b) / Math.max(a, b) < 0.15;
    };

    // Resolve each item's real aspect ratio. Liquid can supply it up front
    // (product images), but some sources don't expose width/height in
    // Liquid, so fall back to the image's actual natural size once loaded —
    // that's always correct regardless of the data source.
    var resolveRatio = function(item) {
      var stored = parseFloat(item.dataset.ratio);
      if (stored && !isNaN(stored)) return Promise.resolve(stored);

      var img = item.querySelector('img');
      if (!img) return Promise.resolve(1);

      return new Promise(function(resolve) {
        var finish = function() {
          var ratio = (img.naturalWidth && img.naturalHeight) ? (img.naturalWidth / img.naturalHeight) : 1;
          item.dataset.ratio = ratio;
          resolve(ratio);
        };
        if (img.complete && img.naturalWidth) {
          finish();
        } else {
          img.addEventListener('load', finish, { once: true });
          img.addEventListener('error', function() { item.dataset.ratio = 1; resolve(1); }, { once: true });
        }
      });
    };

    var getColumnCount = function(width) {
      if (width < 640) return 1;
      if (width < 1024) return 2;
      return 3;
    };

    // Some sources supply several images with near-identical ratios (e.g.
    // multiple wide banner crops). Column-fill alone can still run out of
    // "different-shaped" columns to route them into when too many similar
    // items land close together in the sequence, so first spread
    // similar-ratio items at least `lookback` slots apart in the order —
    // that's roughly one full pass across the columns — before handing the
    // sequence to the column-fill placer.
    var spreadBySimilarRatio = function(itemsArr, lookback) {
      var pool = itemsArr.slice();
      var result = [];
      while (pool.length) {
        var order = pool.map(function(_, idx) { return idx; });
        for (var oi = order.length - 1; oi > 0; oi--) {
          var oj = Math.floor(Math.random() * (oi + 1));
          var t = order[oi]; order[oi] = order[oj]; order[oj] = t;
        }
        var placed = false;
        for (var oi2 = 0; oi2 < order.length; oi2++) {
          var idx = order[oi2];
          var ratio = parseFloat(pool[idx].dataset.ratio) || 1;
          var conflict = false;
          for (var back = 1; back <= lookback && back <= result.length; back++) {
            var prevRatio = parseFloat(result[result.length - back].dataset.ratio) || 1;
            if (ratiosLookSimilar(ratio, prevRatio)) { conflict = true; break; }
          }
          if (!conflict) {
            result.push(pool[idx]);
            pool.splice(idx, 1);
            placed = true;
            break;
          }
        }
        if (!placed) {
          var idxRand = Math.floor(Math.random() * pool.length);
          result.push(pool[idxRand]);
          pool.splice(idxRand, 1);
        }
      }
      return result;
    };

    // Places items one-by-one into the shortest column, but when the
    // shortest column's last item shares this item's ratio bucket, prefers
    // another comparably-short column with a different last bucket instead —
    // that's what stops same-shaped tiles from stacking directly on top of
    // one another.
    var layoutMasonry = function(orderedItems) {
      if (!masonry || !orderedItems.length) return;
      var containerWidth = masonry.clientWidth;
      var columnCount = getColumnCount(window.innerWidth);
      var columnWidth = (containerWidth - GAP * (columnCount - 1)) / columnCount;
      var columnHeights = new Array(columnCount).fill(0);
      var columnLastRatio = new Array(columnCount).fill(null);

      orderedItems.forEach(function(item) {
        var ratio = parseFloat(item.dataset.ratio) || 1;

        var targetCol = 0;
        for (var c = 1; c < columnCount; c++) {
          if (columnHeights[c] < columnHeights[targetCol]) targetCol = c;
        }

        if (ratiosLookSimilar(ratio, columnLastRatio[targetCol])) {
          var altCol = -1;
          for (var c2 = 0; c2 < columnCount; c2++) {
            if (c2 === targetCol || ratiosLookSimilar(ratio, columnLastRatio[c2])) continue;
            if (altCol === -1 || columnHeights[c2] < columnHeights[altCol]) altCol = c2;
          }
          // Only take the alternate column if it won't unbalance the wall.
          if (altCol !== -1 && (columnHeights[altCol] - columnHeights[targetCol]) < columnWidth) {
            targetCol = altCol;
          }
        }

        var itemHeight = columnWidth / ratio;
        var x = targetCol * (columnWidth + GAP);
        var y = columnHeights[targetCol];

        // Position with top/left rather than `transform`: the gallery's
        // scroll-reveal animation (assets/gsap-init.js, targets
        // [data-gs="gallery-item"]) animates each item's `y` transform for
        // its fade/slide-in, which would otherwise fight with — and reset —
        // a transform used for masonry placement.
        item.style.width = columnWidth + 'px';
        item.style.left = x + 'px';
        item.style.top = y + 'px';

        columnHeights[targetCol] = y + itemHeight + GAP;
        columnLastRatio[targetCol] = ratio;
      });

      masonry.style.height = (Math.max.apply(Math, columnHeights) - GAP) + 'px';
    };

    var masonryOrder = [];

    if (masonry) {
      var galleryItems = Array.from(items);

      // Fisher-Yates shuffle for base randomness.
      for (var i = galleryItems.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = galleryItems[i];
        galleryItems[i] = galleryItems[j];
        galleryItems[j] = tmp;
      }

      masonryOrder = galleryItems;

      Promise.all(galleryItems.map(resolveRatio)).then(function() {
        masonryOrder = spreadBySimilarRatio(galleryItems, 3);
        layoutMasonry(masonryOrder);
      });

      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() { layoutMasonry(masonryOrder); }, 150);
      });
    }

    var getVisibleItems = function() {
      return Array.prototype.filter.call(items, function(item) { return item.style.display !== 'none'; });
    };

    var showLightboxImage = function(index) {
      if (!visibleItems.length) return;
      currentIndex = (index + visibleItems.length) % visibleItems.length;
      var item = visibleItems[currentIndex];
      var img = item.querySelector('img');
      var trigger = item.querySelector('[data-title]');
      lightboxImg.src = img ? img.src : '';
      lightboxImg.alt = img ? img.alt : '';
      lightboxTitle.textContent = trigger ? trigger.dataset.title : '';
      lightboxCategory.textContent = '';
    };

    var openLightbox = function(item) {
      visibleItems = getVisibleItems();
      showLightboxImage(visibleItems.indexOf(item));
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      lightboxOpen = true;
      // Backdrop fades in; the figure animates up from below into place
      // with a bounce (the ease-[cubic-bezier(0.34,1.56,0.64,1)] overshoot).
      requestAnimationFrame(function() {
        lightbox.style.opacity = '1';
        lightboxFigure.classList.remove('translate-y-16', 'scale-95', 'opacity-0');
      });
    };

    var closeLightbox = function() {
      lightbox.style.opacity = '0';
      lightboxFigure.classList.add('translate-y-16', 'scale-95', 'opacity-0');
      lightboxOpen = false;
      document.body.style.overflow = '';
      setTimeout(function() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }, 300);
    };

    items.forEach(function(item) {
      item.addEventListener('click', function() { openLightbox(item); });
    });

    document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev').addEventListener('click', function(e) { e.stopPropagation(); showLightboxImage(currentIndex - 1); });
    document.getElementById('lightbox-next').addEventListener('click', function(e) { e.stopPropagation(); showLightboxImage(currentIndex + 1); });
    lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', function(e) {
      if (!lightboxOpen) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') showLightboxImage(currentIndex - 1);
      else if (e.key === 'ArrowRight') showLightboxImage(currentIndex + 1);
    });

    // Filter tabs with GSAP
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var filter = tab.dataset.filter;

        tabs.forEach(function(t) {
          t.classList.remove('active');
          t.style.background = 'rgba(255,255,255,0.6)';
          t.style.color = 'var(--color-muted)';
          t.style.border = '1px solid rgba(45,42,38,0.06)';
        });
        tab.classList.add('active');
        tab.style.background = 'var(--color-blush)';
        tab.style.color = 'white';
        tab.style.border = 'none';

        items.forEach(function(item) {
          var isFirstTab = tabs[0] === tab;
          if (isFirstTab || filter === 'all' || item.dataset.category === filter) {
            gsap.to(item, { opacity: 1, scale: 1, display: 'block', duration: 0.3, ease: 'power2.out' });
          } else {
            gsap.to(item, { opacity: 0, scale: 0.95, duration: 0.3, ease: 'power2.in', onComplete: function() { item.style.display = 'none'; } });
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Portfolio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Showcase"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A curated collection of my finest work."
    },
    {
      "type": "textarea",
      "id": "filter_tabs",
      "label": "Filter Tabs (comma-separated)",
      "info": "Tab labels separated by commas. First tab is active by default. Example: All, Portrait, Character, Illustration",
      "default": "All,Portrait,Character,Illustration"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product Collection",
      "info": "Every image from every product in this collection is added to the gallery, alongside the placeholder artwork above."
    }
  ],
  "presets": [
    {
      "name": "Gallery",
      "settings": {
        "filter_tabs": "All,Portrait,Character,Illustration"
      }
    }
  ]
}
{% endschema %}
