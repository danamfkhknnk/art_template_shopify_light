      <figcaption class="mt-4 text-center">
        <p id="lightbox-category" class="text-caption uppercase tracking-wider" style="color: var(--color-blush);"></p>
        <h3 id="lightbox-title" class="text-subheading font-display mt-1" style="color: var(--color-foreground);"></h3>
      </figcaption>
    </figure>
