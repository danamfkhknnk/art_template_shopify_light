<section data-gs-section="gallery" class="relative pt-36 pb-24 px-4" style="background: linear-gradient(180deg, var(--color-background) 0%, #F5EDE0 50%, var(--color-background) 100%);">
  <!-- Watercolor wash background -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 70% 20%, rgba(155,142,196,0.04) 0%, transparent 50%), radial-gradient(ellipse at 30% 80%, rgba(196,162,101,0.03) 0%, transparent 50%);"></div>

  <div class="relative section-content">
    <!-- Artwork Strip Hero — Gallery specific -->
    <div class="mb-16">
      <div class="text-center">
        <p data-gs="gallery-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
          {{ section.settings.subheading }}
          <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
        </p>
        <h1 data-gs="gallery-heading" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: 0.02em;">
          {{ section.settings.heading }}
        </h1>
        <p data-gs="gallery-heading" class="text-body-lg max-w-md mx-auto" style="color: var(--color-muted);">{{ section.settings.description }}</p>
      </div>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {% assign filter_tabs = section.settings.filter_tabs | split: "," %}
      {% for tab in filter_tabs %}
        <button data-gs="gallery-tab" data-filter="{{ tab | strip | downcase }}" class="filter-tab {% if forloop.first %}active{% endif %} px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300" style="background: {% if forloop.first %}var(--color-blush){% else %}rgba(255,255,255,0.6){% endif %}; color: {% if forloop.first %}white{% else %}var(--color-muted){% endif %}; border: 1px solid rgba(45,42,38,0.06);">{{ tab | strip }}</button>
      {% endfor %}
    </div>

    <!-- Masonry Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[180px] md:auto-rows-[220px]">

      <!-- Item 1 - Large (2x2) -->
      <div data-gs="gallery-item" class="col-span-2 row-span-2 gallery-item" data-category="portrait">
        <div class="group relative h-full cursor-pointer rounded-2xl overflow-hidden transition-all duration-500" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
          <img src="{{ 'gallery1.jpg' | asset_url }}" alt="Ethereal Portrait" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: linear-gradient(180deg, transparent 40%, rgba(250,247,242,0.9) 100%);"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
            <p class="text-caption uppercase tracking-wider mb-1" style="color: var(--color-blush);">Portrait</p>
            <h3 class="text-subheading font-display" style="color: var(--color-foreground);">Ethereal Portrait</h3>
            <p class="text-body-sm mt-1" style="color: var(--color-muted);">Digital painting with custom lighting</p>
          </div>
        </div>
      </div>

      <!-- Item 2 -->
      <div data-gs="gallery-item" class="gallery-item" data-category="character">
        <div class="group relative h-full cursor-pointer rounded-2xl overflow-hidden transition-all duration-500" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
          <img src="{{ 'gallery2.jpg' | asset_url }}" alt="Warrior OC" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy">
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: linear-gradient(180deg, transparent 50%, rgba(250,247,242,0.9) 100%);"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
            <p class="text-caption uppercase tracking-wider" style="color: var(--color-blush);">Character</p>
            <h3 class="text-body font-semibold" style="color: var(--color-foreground);">Warrior OC</h3>
