<section data-gs-section="gallery" class="relative pt-36 pb-24 px-4" style="background: linear-gradient(180deg, var(--color-background) 0%, #F5EDE0 50%, var(--color-background) 100%);">
  <!-- Watercolor wash background -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 70% 20%, rgba(155,142,196,0.04) 0%, transparent 50%), radial-gradient(ellipse at 30% 80%, rgba(196,162,101,0.03) 0%, transparent 50%);"></div>

  <div class="relative section-content">
    <!-- Artwork Strip Hero — Gallery specific -->
    <div class="mb-16">
      <div class="text-center">
        <p data-gs="gallery-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
          {{ section.settings.subheading }}
          <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
        </p>
        <h1 data-gs="gallery-heading" class="font-display mb-4" style="color: var(--color-foreground); font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: 0.02em;">
          {{ section.settings.heading }}
        </h1>
        <p data-gs="gallery-heading" class="text-body-lg max-w-md mx-auto" style="color: var(--color-muted);">{{ section.settings.description }}</p>
      </div>
    </div>

    {% comment %} <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {% assign filter_tabs = section.settings.filter_tabs | split: "," %}
      {% for tab in filter_tabs %}
        <button data-gs="gallery-tab" data-filter="{{ tab | strip | downcase }}" class="filter-tab {% if forloop.first %}active{% endif %} px-5 py-2 rounded-full text-body-sm font-medium transition-all duration-300" style="background: {% if forloop.first %}var(--color-blush){% else %}rgba(255,255,255,0.6){% endif %}; color: {% if forloop.first %}white{% else %}var(--color-muted){% endif %}; border: 1px solid rgba(45,42,38,0.06);">{{ tab | strip }}</button>
      {% endfor %}
    </div> {% endcomment %}

    <!-- Masonry board (VGen-style): card height follows each artwork's real
         aspect ratio instead of a fixed crop, so tall/wide/square pieces all
         sit naturally and the board reads as an organic, varied wall.
         Data source: Hero Metaobjects, as a placeholder until a dedicated
         showcase/portfolio metaobject exists. -->
    {% assign hero_items = shop.metaobjects.hero.values %}
    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
      {% for item in hero_items %}
        {% if item.img %}
          <div data-gs="gallery-item" class="gallery-item mb-4 break-inside-avoid" data-category="{{ item.category | default: 'all' }}">
            <button type="button" class="group relative block w-full cursor-pointer overflow-hidden rounded-2xl transition-all duration-500" data-title="{{ item.title | escape }}" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
              <img
                src="{{ item.img | image_url: width: 800 }}"
                alt="{{ item.img.alt | default: 'Gallery artwork' }}"
                class="block w-full h-auto transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                width="{{ item.img.width }}"
                height="{{ item.img.height }}"
              >
            </button>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="gallery-lightbox" class="fixed inset-0 z-[10000] hidden items-center justify-center p-4" style="background: rgba(250,247,242,0.95); backdrop-filter: blur(12px); opacity:0;transition:opacity .3s ease;" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 z-10 w-9 h-9 md:w-11 md:h-11 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(45,42,38,0.06); color: var(--color-foreground);" aria-label="Close">
      <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <button id="lightbox-prev" class="absolute left-2 md:left-4 z-10 w-9 h-9 md:w-11 md:h-11 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(45,42,38,0.06); color: var(--color-foreground);" aria-label="Previous">
      <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
    </button>
    <button id="lightbox-next" class="absolute right-2 md:right-4 z-10 w-9 h-9 md:w-11 md:h-11 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(45,42,38,0.06); color: var(--color-foreground);" aria-label="Next">
      <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </button>
    <figure id="lightbox-figure" class="flex flex-col items-center max-w-[92vw] md:max-w-4xl translate-y-16 scale-95 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-2xl" style="box-shadow: 0 16px 64px rgba(45,42,38,0.12); border: 1px solid rgba(45,42,38,0.06);">
      <figcaption class="mt-4 text-center">
        <p id="lightbox-category" class="text-caption uppercase tracking-wider" style="color: var(--color-blush);"></p>
        <h3 id="lightbox-title" class="text-subheading font-display mt-1" style="color: var(--color-foreground);"></h3>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var lightbox = document.getElementById('gallery-lightbox');
    var lightboxFigure = document.getElementById('lightbox-figure');
    var lightboxImg = document.getElementById('lightbox-img');
    var lightboxTitle = document.getElementById('lightbox-title');
    var lightboxCategory = document.getElementById('lightbox-category');
    var tabs = document.querySelectorAll('.filter-tab');
    var items = document.querySelectorAll('.gallery-item');
    var visibleItems = [];
    var currentIndex = 0;
    var lightboxOpen = false;

    var getVisibleItems = function() {
      return Array.prototype.filter.call(items, function(item) { return item.style.display !== 'none'; });
    };

    var showLightboxImage = function(index) {
      if (!visibleItems.length) return;
      currentIndex = (index + visibleItems.length) % visibleItems.length;
      var item = visibleItems[currentIndex];
      var img = item.querySelector('img');
      var trigger = item.querySelector('[data-title]');
      lightboxImg.src = img ? img.src : '';
      lightboxImg.alt = img ? img.alt : '';
      lightboxTitle.textContent = trigger ? trigger.dataset.title : '';
      lightboxCategory.textContent = '';
    };

    var openLightbox = function(item) {
      visibleItems = getVisibleItems();
      showLightboxImage(visibleItems.indexOf(item));
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      lightboxOpen = true;
      // Backdrop fades in; the figure animates up from below into place
      // with a bounce (the ease-[cubic-bezier(0.34,1.56,0.64,1)] overshoot).
      requestAnimationFrame(function() {
        lightbox.style.opacity = '1';
        lightboxFigure.classList.remove('translate-y-16', 'scale-95', 'opacity-0');
      });
    };

    var closeLightbox = function() {
      lightbox.style.opacity = '0';
      lightboxFigure.classList.add('translate-y-16', 'scale-95', 'opacity-0');
      lightboxOpen = false;
      document.body.style.overflow = '';
      setTimeout(function() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }, 300);
    };

    items.forEach(function(item) {
      item.addEventListener('click', function() { openLightbox(item); });
    });

    document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev').addEventListener('click', function(e) { e.stopPropagation(); showLightboxImage(currentIndex - 1); });
    document.getElementById('lightbox-next').addEventListener('click', function(e) { e.stopPropagation(); showLightboxImage(currentIndex + 1); });
    lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', function(e) {
      if (!lightboxOpen) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') showLightboxImage(currentIndex - 1);
      else if (e.key === 'ArrowRight') showLightboxImage(currentIndex + 1);
    });

    // Filter tabs with GSAP
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var filter = tab.dataset.filter;

        tabs.forEach(function(t) {
          t.classList.remove('active');
          t.style.background = 'rgba(255,255,255,0.6)';
          t.style.color = 'var(--color-muted)';
          t.style.border = '1px solid rgba(45,42,38,0.06)';
        });
        tab.classList.add('active');
        tab.style.background = 'var(--color-blush)';
        tab.style.color = 'white';
        tab.style.border = 'none';

        items.forEach(function(item) {
          var isFirstTab = tabs[0] === tab;
          if (isFirstTab || filter === 'all' || item.dataset.category === filter) {
            gsap.to(item, { opacity: 1, scale: 1, display: 'block', duration: 0.3, ease: 'power2.out' });
          } else {
            gsap.to(item, { opacity: 0, scale: 0.95, duration: 0.3, ease: 'power2.in', onComplete: function() { item.style.display = 'none'; } });
          }
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Portfolio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Showcase"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A curated collection of my finest work."
    },
    {
      "type": "textarea",
      "id": "filter_tabs",
      "label": "Filter Tabs (comma-separated)",
      "info": "Tab labels separated by commas. First tab is active by default. Example: All, Portrait, Character, Illustration",
      "default": "All,Portrait,Character,Illustration"
    }
  ],
  "presets": [
    {
      "name": "Gallery",
      "settings": {
        "filter_tabs": "All,Portrait,Character,Illustration"
      }
    }
  ]
}
{% endschema %}
