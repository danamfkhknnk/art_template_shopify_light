<section id="team" data-gs-section="team" class="relative overflow-hidden" style="background: var(--bg-team);">
  {% comment %} Heading kept for admin/SEO purposes; the subheading is now rendered visibly above the team title. {% endcomment %}
  <div class="sr-only">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% assign team_members = shop.metaobjects.team.values %}
  {% assign team_count = team_members | size %}

  {% if team_count > 0 %}
    <div class="team-showcase relative mx-auto max-w-[1440px] flex flex-col lg:flex-row lg:items-stretch gap-8 lg:gap-0 px-4 sm:px-6 lg:px-0 py-10 lg:py-6 lg:h-screen lg:max-h-[1024px]">

      <!-- Artwork -->
      <div class="team-artwork order-1 lg:order-2 relative w-full mx-auto max-w-md lg:max-w-none lg:mx-0 lg:w-[520px] lg:shrink-0 aspect-[3/4] lg:aspect-auto lg:h-full lg:my-auto overflow-hidden">
        {% for member in team_members %}
          {% if member.photo %}
            <img
              src="{{ member.photo | image_url: width: 1200 }}"
              alt="{{ member.name }}"
              class="team-slide-image absolute inset-0 h-full w-full object-cover transition-opacity duration-500{% unless forloop.first %} opacity-0 pointer-events-none{% endunless %}"
              data-team-index="{{ forloop.index0 }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="520"
              height="1024"
            >
          {% endif %}
        {% endfor %}
      </div>

      <!-- Thumbnail nav -->
      <div class="team-thumbs order-2 lg:order-1 flex lg:flex-col gap-4 lg:gap-6 overflow-x-auto lg:overflow-x-visible lg:overflow-y-auto lg:w-[78px] lg:ml-[93px] lg:mr-16 lg:my-auto no-scrollbar">
        {% for member in team_members %}
          <button
            type="button"
            class="team-thumb shrink-0 w-16 h-30 lg:w-full lg:aspect-square rounded-lg overflow-hidden transition-opacity duration-300{% if forloop.first %} opacity-100{% else %} opacity-35{% endif %}"
            data-team-index="{{ forloop.index0 }}"
            aria-label="{{ member.name }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {% if member.logo %}
              <img src="{{ member.logo | image_url: width: 200 }}" alt="" class="h-full w-full object-cover" loading="lazy" width="78" height="78">
            {% endif %}
          </button>
        {% endfor %}
      </div>

      <!-- Content -->
      <div class="team-content order-3 flex flex-col justify-center lg:pl-16 lg:w-[529px] lg:my-auto">
        <!-- Subheading (section marker, matches About's eyebrow label) -->
        <p data-gs="team-text" class="text-caption tracking-[0.2em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-6 h-px" style="background: var(--color-blush);"></span>
          {{ section.settings.subheading }}
        </p>

        {% for member in team_members %}
          <div class="team-slide-content{% unless forloop.first %} hidden{% endunless %}" data-team-index="{{ forloop.index0 }}">
            <h3 class="team-title font-display uppercase leading-[0.95] mb-6 break-words" style="color: var(--color-foreground); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400;">{{ member.name }}</h3>
            <div class="h-2 w-full max-w-[390px]" style="background: #10b981; margin-bottom: 2rem;"></div>
            <div class="text-base lg:text-lg leading-relaxed mb-10" style="color: var(--color-muted);">
              {{ member.description }}
            </div>
            <a href="{{ section.settings.cta_link | default: '/pages/product' }}" class="btn-primary inline-flex items-center gap-2">
              <span>{{ section.settings.cta_label | default: 'Check My Art' }}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        {% endfor %}

        {% if team_count > 1 %}
          <div class="team-nav flex items-center gap-3 mt-16">
            <button type="button" class="team-prev team-nav-btn flex h-12 w-12 items-center justify-center transition-colors duration-300" aria-label="Previous artist">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" class="team-next team-nav-btn team-nav-btn--active flex h-12 w-12 items-center justify-center transition-colors duration-300" aria-label="Next artist">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    <script>
      (function () {
        var section = document.currentScript.closest('[data-gs-section="team"]');
        if (!section) return;

        var thumbs = Array.prototype.slice.call(section.querySelectorAll('.team-thumb'));
        var images = Array.prototype.slice.call(section.querySelectorAll('.team-slide-image'));
        var contents = Array.prototype.slice.call(section.querySelectorAll('.team-slide-content'));
        var total = thumbs.length;
        if (!total) return;

        var current = 0;

        function setActive(index) {
          current = ((index % total) + total) % total;

          thumbs.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('opacity-100', isActive);
            el.classList.toggle('opacity-35', !isActive);
            el.setAttribute('aria-current', isActive ? 'true' : 'false');
          });

          images.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('opacity-0', !isActive);
            el.classList.toggle('pointer-events-none', !isActive);
          });

          contents.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('hidden', !isActive);
          });
        }

        thumbs.forEach(function (el) {
          el.addEventListener('click', function () {
            setActive(Number(el.dataset.teamIndex));
          });
        });

        var prevBtn = section.querySelector('.team-prev');
        var nextBtn = section.querySelector('.team-next');
        if (prevBtn) prevBtn.addEventListener('click', function () { setActive(current - 1); });
        if (nextBtn) nextBtn.addEventListener('click', function () { setActive(current + 1); });
      })();
    </script>
  {% endif %}
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  #team .team-nav-btn {
    border: 1px solid rgba(45, 42, 38, 0.15);
    color: var(--color-muted);
  }
  #team .team-nav-btn:hover,
  #team .team-nav-btn--active {
    border-color: rgba(45, 42, 38, 0.5);
    color: var(--color-foreground);
  }
</style>

{% schema %}
{
  "name": "Our Team",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet The Artists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Team"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Check My Arts"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Our Team"
    }
  ]
}
{% endschema %}
