<section id="team" data-gs-section="team" class="relative py-20 px-4" style="background: var(--bg-team);">
  <div class="relative section-content">

      {% assign team_members = shop.metaobjects.team.values %}
      {% assign team_count = team_members | size %}

    {% if section.settings.heading != blank %}
      {% if team_count > 4 %}
        <div class="flex items-end justify-between mb-12">
          <div>
            <p data-gs="team-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
              <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
              {{ section.settings.subheading }}
              <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
            </p>
            <h2 data-gs="team-heading" class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
          </div>
          <div data-gs="team-heading" class="hidden md:flex items-center gap-2">
            <button class="team-prev w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button class="team-next w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      {% else %}
        <div class="text-center mb-12">
          <p data-gs="team-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
            <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
            {{ section.settings.subheading }}
            <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
          </p>
          <h2 data-gs="team-heading" class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
    {% endif %}

    {% if team_count > 4 %}
      <div class="swiper team-swiper">
        <div class="swiper-wrapper">
          {% for product in team_members %}
            <div class="swiper-slide" data-gs="team-card">
              <div class="group rounded-2xl overflow-hidden h-full transition-all duration-500 hover:-translate-y-1" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
                {% if product.photo %}
                  <div class="relative aspect-[3/4] overflow-hidden">
                    <img src="{{ product.photo | image_url: width: 600 }}" alt="{{ product.name }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" width="400" height="533">
                    <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 50%, rgba(250,247,242,0.4) 80%, rgba(250,247,242,0.95) 100%);"></div>
                  </div>
                {% endif %}
                <div class="p-6">
                  <h3 class="text-lg font-display mb-1" style="color: var(--color-foreground);">{{ product.name }}</h3>
                  <p class="text-body-sm leading-relaxed mb-5" style="color: var(--color-muted);">{{ product.description }}</p>
                  <div class="flex items-center gap-2">
                    {% if product.twitter != blank %}
                      <a data-gs="team-social" href="{{ product.twitter }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                        <iconify-icon icon="simple-icons:x" class="w-4 h-4" style="color: var(--color-muted);" aria-hidden="true"></iconify-icon>
                      </a>
                    {% endif %}
                    {% if product.instagram != blank %}
                      <a data-gs="team-social" href="{{ product.instagram }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                        <iconify-icon icon="simple-icons:instagram" class="w-4 h-4" style="color: var(--color-muted);" aria-hidden="true"></iconify-icon>
                      </a>
                    {% endif %}
                    {% if product.linkedin != blank %}
                      <a data-gs="team-social" href="{{ product.linkedin }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                        <iconify-icon icon="simple-icons:linkedin" class="w-4 h-4" style="color: var(--color-muted);" aria-hidden="true"></iconify-icon>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          new Swiper('.team-swiper', {
            slidesPerView: 1,
            spaceBetween: 16,
            loop: true,
            centeredSlides: true,
            navigation: {
              prevEl: '.team-prev',
              nextEl: '.team-next',
            },
            breakpoints: {
              768: { slidesPerView: 2.3, spaceBetween: 20 },
              1024: { slidesPerView: 3.3, spaceBetween: 24 },
              1280: { slidesPerView: 4, spaceBetween: 24 },
            }
          });
        });
      </script>

    {% else %}
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 justify-items-center">
        {% for product in team_members %}
          <div data-gs="team-card" class="group w-full">
            <div class="rounded-2xl overflow-hidden h-full transition-all duration-500 hover:-translate-y-1" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
              {% if product.photo %}
                <div class="relative aspect-[3/4] overflow-hidden">
                  <img src="{{ product.photo | image_url: width: 600 }}" alt="{{ product.name }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" width="400" height="533">
                  <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 50%, rgba(250,247,242,0.4) 80%, rgba(250,247,242,0.95) 100%);"></div>
                </div>
              {% endif %}
              <div class="p-6">
                <h3 class="text-lg font-display mb-1" style="color: var(--color-foreground);">{{ product.name }}</h3>
                <p class="text-body-sm leading-relaxed mb-5" style="color: var(--color-muted);">{{ product.description }}</p>
                <div class="flex items-center gap-2">
                  {% if product.twitter != blank %}
                    <a data-gs="team-social" href="{{ product.twitter }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                      <iconify-icon icon="simple-icons:x" class="w-4 h-4" style="color: var(--color-muted);" aria-hidden="true"></iconify-icon>
                    </a>
                  {% endif %}
                  {% if product.instagram != blank %}
                    <a data-gs="team-social" href="{{ product.instagram }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                      <iconify-icon icon="simple-icons:instagram" class="w-4 h-4" style="color: var(--color-muted);" aria-hidden="true"></iconify-icon>
                    </a>
                  {% endif %}
                  {% if product.linkedin != blank %}
                    <a data-gs="team-social" href="{{ product.linkedin }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                      <iconify-icon icon="simple-icons:linkedin" class="w-4 h-4" style="color: var(--color-muted);" aria-hidden="true"></iconify-icon>
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Our Team",
  "tag": "section",
  "class": "shopify-section",
  "settings": [

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet The Artists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Team"
    }
  ],
  "presets": [
    {
      "name": "Our Team"
    }
  ]
}
{% endschema %}
