<section id="team" data-gs-section="team" class="relative py-20 px-4" style="background: var(--bg-team);">
  <div class="relative section-content">

    {% assign collection = collections[section.settings.collection] %}
    {% assign team_count = collection.products | size %}

    {% if section.settings.heading != blank %}
      {% if team_count > 4 %}
        <div class="flex items-end justify-between mb-12">
          <div>
            <p data-gs="team-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
              <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
              {{ section.settings.subheading }}
              <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
            </p>
            <h2 data-gs="team-heading" class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
          </div>
          <div data-gs="team-heading" class="hidden md:flex items-center gap-2">
            <button class="team-prev w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button class="team-next w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      {% else %}
        <div class="text-center mb-12">
          <p data-gs="team-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
            <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
            {{ section.settings.subheading }}
            <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
          </p>
          <h2 data-gs="team-heading" class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
    {% endif %}

    {% if team_count > 4 %}
      <div class="swiper team-swiper">
        <div class="swiper-wrapper">
          {% for product in collection.products %}
            <div class="swiper-slide" data-gs="team-card">
              <div class="group rounded-2xl overflow-hidden h-full transition-all duration-500 hover:-translate-y-1" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
                {% if product.featured_image %}
                  <div class="relative aspect-[3/4] overflow-hidden">
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" width="400" height="533">
                    <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 50%, rgba(250,247,242,0.4) 80%, rgba(250,247,242,0.95) 100%);"></div>
                  </div>
                {% endif %}
                <div class="p-6">
                  <h3 class="text-lg font-display mb-1" style="color: var(--color-foreground);">{{ product.title }}</h3>
                  <p class="text-body-sm leading-relaxed mb-5" style="color: var(--color-muted);">{{ product.content }}</p>
                  <div class="flex items-center gap-2">
                    {% if product.metafields.custom.twitter != blank %}
                      <a data-gs="team-social" href="{{ product.metafields.custom.twitter }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                        <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                      </a>
                    {% endif %}
                    {% if product.metafields.custom.instagram != blank %}
                      <a data-gs="team-social" href="{{ product.metafields.custom.instagram }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                        <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                      </a>
                    {% endif %}
                    {% if product.metafields.custom.linkedin != blank %}
                      <a data-gs="team-social" href="{{ product.metafields.custom.linkedin }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                        <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M4.935 0A4.924 4.924 0 000 4.935v14.13A4.924 4.924 0 004.935 24h14.13A4.924 4.924 0 0024 19.065V4.935A4.924 4.924 0 0019.065 0zm7.826 3.19c2.853 0 5.165 2.312 5.165 5.165v1.594c0 2.853-2.312 5.165-5.165 5.165-2.853 0-5.165-2.312-5.165-5.165V8.355c0-2.853 2.312-5.165 5.165-5.165zm0 2.366c-1.552 0-2.799 1.247-2.799 2.799v1.594c0 1.552 1.247 2.799 2.799 2.799 1.552 0 2.799-1.247 2.799-2.799V8.355c0-1.552-1.247-2.799-2.799-2.799zm5.067 2.013c.55 0 .996.446.996.996s-.446.996-.996.996-.996-.446-.996-.996.446-.996.996-.996zm-5.067 1.498c.87 0 1.575.705 1.575 1.575v1.594c0 .87-.705 1.575-1.575 1.575-.87 0-1.575-.705-1.575-1.575V9.637c0-.87.705-1.575 1.575-1.575z"/></svg>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          new Swiper('.team-swiper', {
            slidesPerView: 1,
            spaceBetween: 16,
            loop: true,
            centeredSlides: true,
            navigation: {
              prevEl: '.team-prev',
              nextEl: '.team-next',
            },
            breakpoints: {
              768: { slidesPerView: 2.3, spaceBetween: 20 },
              1024: { slidesPerView: 3.3, spaceBetween: 24 },
              1280: { slidesPerView: 4, spaceBetween: 24 },
            }
          });
        });
      </script>

    {% else %}
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 justify-items-center">
        {% for product in collection.products %}
          <div data-gs="team-card" class="group w-full">
            <div class="rounded-2xl overflow-hidden h-full transition-all duration-500 hover:-translate-y-1" style="background: white; box-shadow: var(--shadow-card); border: 1px solid rgba(45,42,38,0.05);">
              {% if product.featured_image %}
                <div class="relative aspect-[3/4] overflow-hidden">
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" width="400" height="533">
                  <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 50%, rgba(250,247,242,0.4) 80%, rgba(250,247,242,0.95) 100%);"></div>
                </div>
              {% endif %}
              <div class="p-6">
                <h3 class="text-lg font-display mb-1" style="color: var(--color-foreground);">{{ product.title }}</h3>
                <p class="text-body-sm leading-relaxed mb-5" style="color: var(--color-muted);">{{ product.content }}</p>
                <div class="flex items-center gap-2">
                  {% if product.metafields.custom.twitter != blank %}
                    <a data-gs="team-social" href="{{ product.metafields.custom.twitter }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                      <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                  {% endif %}
                  {% if product.metafields.custom.instagram != blank %}
                    <a data-gs="team-social" href="{{ product.metafields.custom.instagram }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                      <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                  {% endif %}
                  {% if product.metafields.custom.linkedin != blank %}
                    <a data-gs="team-social" href="{{ product.metafields.custom.linkedin }}" target="_blank" class="w-9 h-9 rounded-full flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.06);">
                      <svg class="w-4 h-4" style="color: var(--color-muted);" fill="currentColor" viewBox="0 0 24 24"><path d="M4.935 0A4.924 4.924 0 000 4.935v14.13A4.924 4.924 0 004.935 24h14.13A4.924 4.924 0 0024 19.065V4.935A4.924 4.924 0 0019.065 0zm7.826 3.19c2.853 0 5.165 2.312 5.165 5.165v1.594c0 2.853-2.312 5.165-5.165 5.165-2.853 0-5.165-2.312-5.165-5.165V8.355c0-2.853 2.312-5.165 5.165-5.165zm0 2.366c-1.552 0-2.799 1.247-2.799 2.799v1.594c0 1.552 1.247 2.799 2.799 2.799 1.552 0 2.799-1.247 2.799-2.799V8.355c0-1.552-1.247-2.799-2.799-2.799zm5.067 2.013c.55 0 .996.446.996.996s-.446.996-.996.996-.996-.446-.996-.996.446-.996.996-.996zm-5.067 1.498c.87 0 1.575.705 1.575 1.575v1.594c0 .87-.705 1.575-1.575 1.575-.87 0-1.575-.705-1.575-1.575V9.637c0-.87.705-1.575 1.575-1.575z"/></svg>
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Our Team",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Team Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet The Artists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Team"
    }
  ],
  "presets": [
    {
      "name": "Our Team"
    }
  ]
}
{% endschema %}
