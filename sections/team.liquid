<section id="team" data-gs-section="team" class="relative lg:scroll-mt-20 overflow-hidden" style="background: var(--bg-team);" >
  {% comment %} Heading kept for admin/SEO purposes; the subheading is now rendered visibly above the team title. {% endcomment %}
  <div class="sr-only">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% assign team_members = shop.metaobjects.team.values %}
  {% assign team_count = team_members | size %}

  {% if team_count > 0 %}
    <div class="team-showcase relative mx-auto max-w-[1440px] flex flex-col lg:flex-row lg:items-stretch gap-6 lg:gap-0 w-[90%] lg:w-full lg:px-0 py-20 lg:py-6 lg:h-[90vh]">

      <!-- Mobile/tablet-only: heading + subheading (centered) -->
      <div class="flex lg:hidden w-full flex-col items-center text-center gap-4">
        <div>
          <p data-gs="team-text" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
            <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
            {{ section.settings.subheading }}
            <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
          </p>
          <h2 class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
        </div>
      </div>

      <!-- Artwork -->
      <div class="team-artwork order-1 lg:order-2 relative w-full mx-auto max-w-md lg:max-w-none lg:mx-0 lg:w-[520px] lg:shrink-0 aspect-[3/4] lg:aspect-auto lg:h-full lg:my-auto overflow-hidden rounded-2xl">
        {% for member in team_members %}
          {% if member.photo %}
            <img
              src="{{ member.photo | image_url: width: 1200 }}"
              alt="{{ member.name }}"
              class="team-slide-image absolute inset-0 h-full w-full object-cover transition-opacity duration-500{% unless forloop.first %} opacity-0 pointer-events-none{% endunless %}"
              data-team-index="{{ forloop.index0 }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="520"
              height="1024"
            >
          {% endif %}
        {% endfor %}

        <!-- Mobile/tablet-only: name + description overlaid on the artwork -->
        <div class="lg:hidden absolute inset-x-0 bottom-0 p-5 pt-24 bg-[linear-gradient(180deg,transparent_0%,rgba(45,42,38,.55)_40%,rgba(45,42,38,.95)_100%)]">
          {% for member in team_members %}
            <div class="team-slide-content-mobile{% unless forloop.first %} hidden{% endunless %}" data-team-index="{{ forloop.index0 }}">
              <h3 class=" uppercase leading-[0.95] mb-2 break-words text-[var(--color-cream)]" style="font-size: clamp(1.5rem, 6vw, 2.25rem); font-weight: 400;">{{ member.name }}</h3>
              <div class="text-body-sm leading-relaxed text-[rgba(245,237,224,.85)]">
                {{ member.description }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Thumbnail nav -->
      <div class="team-thumbs order-2 lg:order-1 flex justify-center lg:justify-start lg:flex-col gap-4 lg:gap-6 overflow-x-auto lg:overflow-x-visible lg:overflow-y-auto lg:w-[100px] xl:w-[78px] xl:ml-[93px] lg:ml-[70px] xl:mr-16 lg:mr-10 lg:my-auto no-scrollbar">
        {% for member in team_members %}
          <button
            type="button"
            class="team-thumb shrink-0 w-20 h-30 lg:w-full lg:aspect-square rounded-lg overflow-hidden transition-opacity duration-300{% if forloop.first %} opacity-100{% else %} opacity-35{% endif %}"
            data-team-index="{{ forloop.index0 }}"
            aria-label="{{ member.name }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {% if member.photo %}
              <img src="{{ member.photo | image_url: width: 200 }}" alt="" class="h-full w-full object-cover" loading="lazy" width="78" height="78">
            {% endif %}
          </button>
        {% endfor %}
      </div>

      <!-- Content -->
      <div class="team-content order-3 flex flex-col justify-center lg:pl-16 lg:w-[529px] lg:my-auto">
        <!-- Subheading (desktop only — mobile/tablet version is in the top row) -->
        <p class="hidden lg:inline-flex text-caption tracking-[0.2em] uppercase mb-4 font-medium items-center gap-2" style="color: var(--color-blush);">
          <span class="w-6 h-px" style="background: var(--color-blush);"></span>
          {{ section.settings.subheading }}
        </p>

        {% for member in team_members %}
          <div class="team-slide-content{% unless forloop.first %} hidden{% endunless %}" data-team-index="{{ forloop.index0 }}">
            <h3 class="hidden lg:block team-title font-display uppercase leading-[0.95] mb-6 break-words" style="color: var(--color-foreground); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400;">{{ member.name }}</h3>
            <div class="hidden lg:block h-2 w-full max-w-[390px]" style="background: var(--gradient-primary); margin-bottom: 2rem;"></div>
            <div class="hidden lg:block text-base lg:text-lg leading-relaxed mb-10" style="color: var(--color-muted);">
              {{ member.description }}
            </div>
            <a href="{{ section.settings.cta_link | default: '/pages/product' }}" class="hidden lg:inline-flex btn-primary items-center gap-2">
              <span>{{ section.settings.cta_label | default: 'What i Can' }}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        {% endfor %}

        
      </div>
    </div>

    <script>
      (function () {
        var section = document.currentScript.closest('[data-gs-section="team"]');
        if (!section) return;

        var thumbs = Array.prototype.slice.call(section.querySelectorAll('.team-thumb'));
        var images = Array.prototype.slice.call(section.querySelectorAll('.team-slide-image'));
        var contents = Array.prototype.slice.call(section.querySelectorAll('.team-slide-content'));
        var mobileContents = Array.prototype.slice.call(section.querySelectorAll('.team-slide-content-mobile'));
        var total = thumbs.length;
        if (!total) return;

        var current = 0;
        var autoSlideInterval;
        var autoSlideDelay = 3000; // 5 seconds

        function setActive(index) {
          current = ((index % total) + total) % total;

          thumbs.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('opacity-100', isActive);
            el.classList.toggle('opacity-35', !isActive);
            el.setAttribute('aria-current', isActive ? 'true' : 'false');
          });

          images.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('opacity-0', !isActive);
            el.classList.toggle('pointer-events-none', !isActive);
          });

          contents.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('hidden', !isActive);
          });

          mobileContents.forEach(function (el) {
            var isActive = Number(el.dataset.teamIndex) === current;
            el.classList.toggle('hidden', !isActive);
          });
        }

        function nextSlide() {
          setActive(current + 1);
        }

        function startAutoSlide() {
          autoSlideInterval = setInterval(nextSlide, autoSlideDelay);
        }

        function stopAutoSlide() {
          clearInterval(autoSlideInterval);
        }

        thumbs.forEach(function (el) {
          el.addEventListener('click', function () {
            setActive(Number(el.dataset.teamIndex));
            stopAutoSlide();
            startAutoSlide(); // Reset timer on manual interaction
          });
        });

        // Pause auto-slide on hover
        var showcase = section.querySelector('.team-showcase');
        if (showcase) {
          showcase.addEventListener('mouseenter', stopAutoSlide);
          showcase.addEventListener('mouseleave', startAutoSlide);
        }

        // Start auto-slide
        startAutoSlide();
      })();
    </script>
  {% endif %}
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  #team .team-nav-btn {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(45, 42, 38, 0.08);
    color: var(--color-muted);
  }
</style>

{% schema %}
{
  "name": "Our Team",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Team"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet The Artists"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "What I Can"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Our Team"
    }
  ]
}
{% endschema %}
