<section data-gs-section="faq" class="relative py-20 px-4" style="background: var(--bg-faq);">
  <!-- Watercolor wash accent -->
  <div class="absolute top-0 left-0 w-full h-full pointer-events-none" style="background: radial-gradient(ellipse at 15% 20%, rgba(155,142,196,0.04) 0%, transparent 50%), radial-gradient(ellipse at 85% 80%, rgba(196,114,127,0.03) 0%, transparent 50%);"></div>

  <div class="relative section-content">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] gap-10 lg:gap-16">

      <!-- Sticky heading -->
      <div data-gs="faq-sticky" class="lg:sticky lg:top-28 lg:self-start">
        <div>
          <p class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
            <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
            {{ section.settings.subheading }}
          </p>
          <h2 class="text-heading font-display mb-4" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
        </div>

        {% if section.settings.description != blank %}
          <p class="text-body leading-relaxed mb-8" style="color: var(--color-muted);">{{ section.settings.description }}</p>
        {% endif %}
      </div>

      <!-- Accordion -->
      <div class="flex flex-col gap-3">
        {% for block in section.blocks %}
          <div data-gs="faq-item" class="faq-item watercolor-card overflow-hidden" {{ block.shopify_attributes }}>
            <button type="button" class="faq-toggle w-full flex items-start justify-between gap-4 p-6 text-left transition-colors duration-300">
              <span class="text-body font-medium" style="color: var(--color-foreground);">{{ block.settings.question }}</span>
              <svg class="w-5 h-5 shrink-0 faq-icon transition-transform duration-300 mt-0.5" style="color: var(--color-blush);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-500">
              <div class="px-6 pb-6 text-body-sm leading-relaxed" style="color: var(--color-muted); border-top: 1px solid rgba(45,42,38,0.06); padding-top: 1rem;">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.cta_label != blank %}
        <div class="lg:hidden mt-8 text-center">
          <a href="{{ section.settings.cta_link | default: '#' }}" class="btn-primary inline-flex items-center gap-2">
            <span>{{ section.settings.cta_label }}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('[data-gs-section="faq"]');
    if (!section) return;

    section.querySelectorAll('.faq-toggle').forEach(function (toggle) {
      toggle.addEventListener('click', function () {
        var content = toggle.nextElementSibling;
        var icon = toggle.querySelector('.faq-icon');
        var isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
        } else {
          content.style.maxHeight = '0px';
          icon.style.transform = 'rotate(0deg)';
        }
      });
    });
  });
</script>

<style>
  .faq-toggle:hover .faq-icon {
    transform: translateY(2px);
  }
  .faq-item .faq-toggle:hover {
    background: rgba(196, 114, 127, 0.03);
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Got Questions?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Can't find what you're looking for? Reach out anytime."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does a commission take?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Turnaround usually takes 1-3 weeks depending on complexity and current queue length. You'll get updates along the way."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long does a commission take?",
            "answer": "Turnaround usually takes 1-3 weeks depending on complexity and current queue length. You'll get updates along the way."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "All major cards and PayPal are accepted at checkout, processed securely through Shopify."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I request revisions?",
            "answer": "Yes, each commission includes a set number of revision rounds so the final piece matches your vision."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you offer commercial usage rights?",
            "answer": "Commercial licensing is available as an add-on. Reach out before ordering if you need it for a business or product."
          }
        }
      ]
    }
  ]
}
{% endschema %}
