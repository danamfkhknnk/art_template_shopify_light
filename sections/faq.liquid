<section class="relative pt-12 pb-24 px-4" style="background: var(--color-background);">
  <div class="relative section-content">
    <!-- Split layout: sticky heading left + accordion right -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-32">
          <p class="text-caption tracking-[0.2em] uppercase mb-4 font-semibold inline-flex items-center gap-2 reveal" style="color: var(--color-blush);">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"/></svg>
            {{ section.settings.subheading }}
          </p>
          <h2 class="text-heading font-display mb-6 reveal reveal-delay-1" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
          <p class="text-body leading-relaxed mb-8 reveal reveal-delay-2" style="color: var(--color-muted);">
            Still have questions? Reach out and I'll get back to you as soon as possible.
          </p>
          <a href="/#contact" class="btn-secondary inline-flex items-center gap-2 reveal reveal-delay-2">
            <span>Contact Me</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-4">
      {% for block in section.blocks %}
        <div class="watercolor-card overflow-hidden reveal" style="transition-delay: {{ forloop.index | times: 0.05 }}s;" {{ block.shopify_attributes }}>
          <button class="faq-toggle w-full flex items-center justify-between p-6 text-left transition-colors duration-300" style="background: transparent;">
            <span class="text-body font-medium pr-4" style="color: var(--color-foreground);">{{ block.settings.question }}</span>
            <svg class="w-5 h-5 shrink-0 faq-icon transition-transform duration-300" style="color: var(--color-blush);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-500">
            <div class="px-6 pb-6 text-body-sm leading-relaxed" style="color: var(--color-muted); border-top: 1px solid rgba(45,42,38,0.06); padding-top: 1rem;">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.faq-toggle').forEach(toggle => {
      toggle.addEventListener('click', () => {
        const content = toggle.nextElementSibling;
        const icon = toggle.querySelector('.faq-icon');
        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        document.querySelectorAll('.faq-content').forEach(c => {
          c.style.maxHeight = '0px';
        });
        document.querySelectorAll('.faq-icon').forEach(i => {
          i.style.transform = 'rotate(0deg)';
        });

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does a commission take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>It depends on the complexity. Simple portraits take 3-5 days, while complex illustrations can take 1-2 weeks. I'll provide an estimated timeline when you commission.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How long does a commission take?",
            "answer": "<p>It depends on the complexity. Simple portraits take 3-5 days, while complex illustrations can take 1-2 weeks. I'll provide an estimated timeline when you commission.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>I accept PayPal, Stripe, and bank transfer. Payment is typically split 50% upfront and 50% upon completion.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I use the artwork commercially?",
            "answer": "<p>Commercial use is included in Standard and Premium plans. For Basic plans, you can add commercial use as an add-on for $50.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer revisions?",
            "answer": "<p>Yes! Basic includes 2 revisions, Standard includes 4, and Premium includes unlimited revisions.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if I'm not satisfied with the result?",
            "answer": "<p>I offer unlimited revisions for Premium plans and up to 4 for Standard. Your satisfaction is my priority.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
