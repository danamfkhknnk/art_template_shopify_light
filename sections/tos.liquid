<section class="relative pt-32 pb-20 px-4" style="background: var(--color-background);">
  <div class="relative section-content max-w-3xl">
    <!-- TOS Hero — Minimal & Legal specific -->
    <div class="text-center mb-16 reveal">
      <p class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-sage);">
        <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-sage));"></span>
        Legal
        <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-sage));"></span>
      </p>
      <h1 class="font-display font-bold mb-4" style="color: var(--color-foreground); font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.02em;">
        {{ section.settings.heading }}
      </h1>
      <p class="text-body-lg max-w-lg mx-auto" style="color: var(--color-muted);">
        Please read these terms carefully before using our services.
      </p>
      {% if section.settings.last_updated != blank %}
        <p class="text-caption mt-4" style="color: var(--color-muted);">Last updated: {{ section.settings.last_updated }}</p>
      {% endif %}
    </div>

    <div class="prose max-w-none reveal reveal-delay-2">
      {% if section.settings.content != blank %}
        <div class="text-body leading-relaxed space-y-4" style="color: var(--color-muted);">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Terms of Service",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Terms of Service"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>These terms of service govern your use of our art commission services. By commissioning us, you agree to these terms.</p><h3>Payment Terms</h3><p>Full payment is required before work begins. We accept major credit cards and PayPal.</p><h3>Revision Policy</h3><p>Each commission includes up to 3 revisions. Additional revisions may incur extra charges.</p><h3>Usage Rights</h3><p>Upon full payment, you receive a license to use the artwork for personal or commercial purposes.</p>"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last Updated",
      "default": "January 2025"
    }
  ],
  "presets": [
    {
      "name": "Terms of Service"
    }
  ]
}
{% endschema %}
