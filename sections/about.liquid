<section data-gs-section="about" class="relative py-20 px-4" style="background: var(--bg-about);">
  <!-- Parallax watercolor blob -->
  <div data-gs="parallax-blob" data-speed="0.2" class="absolute -top-20 -right-20 w-96 h-96 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(196,114,127,0.05), transparent 70%); filter: blur(40px);"></div>

  <div class="relative section-content">
    <!-- Diagonal Split Layout -->
    <div class="relative grid grid-cols-1 sm:grid-cols-2 gap-0 items-stretch min-h-[500px] lg:min-h-[600px]">

      <!-- LEFT: Photo with diagonal cut -->
      <div data-gs="about-photo" class="relative aspect-square sm:aspect-auto">
        <!-- Photo container with diagonal clip -->
        <div class="absolute inset-0 lg:inset-0 flex items-center" style="clip-path: polygon(0 0, 100% 0, 85% 100%, 0 100%);">
          <img
            src="{{ 'about.webp' | asset_url }}"
            alt="{{ section.settings.heading }}"
            class="w-full h-auto"
            loading="lazy"
            width="800"
            height="600"
          >
          <!-- Watercolor wash overlay -->
          <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(196,114,127,0.08) 0%, transparent 40%, rgba(155,142,196,0.06) 100%);"></div>
        </div>

        <!-- Decorative watercolor blob behind photo -->
        <div class="absolute -bottom-8 -left-8 w-40 h-40 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(196,114,127,0.1), transparent 70%); filter: blur(20px);"></div>
      </div>

      <!-- RIGHT: Text + Stats -->
      <div class="flex flex-col justify-center py-12 lg:pl-16">
        <!-- Subheading -->
        <p data-gs="about-text" class="text-caption tracking-[0.2em] uppercase mb-4 font-medium inline-flex items-center gap-2" style="color: var(--color-blush);">
          <span class="w-6 h-px" style="background: var(--color-blush);"></span>
          {{ section.settings.subheading }}
        </p>

        <!-- Heading -->
        <h2 data-gs="about-text" class="text-heading font-display mb-6" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>

        <!-- Content -->
        <div data-gs="about-text" class="text-body leading-relaxed mb-8" style="color: var(--color-muted);">
          {{ section.settings.content }}
        </div>

        <!-- CTA Button -->
        <div>
          <a data-gs="about-cta" href="{{ section.settings.cta_link }}" class="btn-primary inline-flex items-center gap-2">
            <span>{{ section.settings.cta_label }}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Diagonal clip — responsive fix for mobile */
  @media (max-width: 1023px) {
    .section-content [style*="clip-path"] {
      clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%) !important;
    }
  }
</style>

{% schema %}
{
  "name": "About",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "About Me"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Artist Behind The Work"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>I've been drawing since I was a kid, spending hours sketching characters and worlds that lived in my imagination. What started as a hobby quickly became my passion.</p><p>Over the years, I've honed my skills in digital illustration, character design, and now Shopify theme design. I combine my artistic background with modern web design to create templates that don't just look good, they tell a story.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "View Showcase"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
