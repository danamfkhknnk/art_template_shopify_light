<section data-gs-section="testimonials" class="relative py-20 px-4 overflow-x-hidden" style="background: var(--bg-testimonials);">
  <div class="relative section-content">
    <div class="text-center mb-16">
      <p data-gs="test-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2 justify-center" style="color: var(--color-blush);">
        <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
      </p>
      <h2 data-gs="test-heading" class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
    </div>

    <!-- Slider controls -->
    <div class="flex justify-end gap-2 mb-6">
      <button onclick="document.getElementById('testimonial-track').scrollBy({ left: -400, behavior: 'smooth' })" class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button onclick="document.getElementById('testimonial-track').scrollBy({ left: 400, behavior: 'smooth' })" class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300" style="background: rgba(255,255,255,0.6); border: 1px solid rgba(45,42,38,0.08); color: var(--color-muted);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <div id="testimonial-track" class="flex gap-6 overflow-x-auto overflow-y-hidden scroll-smooth snap-x snap-mandatory pb-4 -mx-4 px-4 max-h-[420px]" style="-ms-overflow-style:none; scrollbar-width:none;">
      <style>
        #testimonial-track::-webkit-scrollbar { display: none; }
      </style>
      {% for block in section.blocks %}
        <div data-gs="test-card" class="watercolor-card p-8 relative group shrink-0 w-[85vw] md:w-[calc(50%-12px)] snap-center overflow-hidden" {{ block.shopify_attributes }}>
          <!-- Watercolor quote accent -->
          <div class="absolute top-0 right-0 w-24 h-24 opacity-30 pointer-events-none" style="background: radial-gradient(circle, rgba(196,114,127,0.15), transparent 70%); border-radius: 50%;"></div>

          <svg data-gs="test-icon" class="w-10 h-10 mb-4" style="color: rgba(196,114,127,0.25);" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <p class="text-body leading-relaxed mb-6 italic" style="color: var(--color-muted);">"{{ block.settings.quote }}"</p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center" style="background: rgba(196,114,127,0.08); border: 1px solid rgba(196,114,127,0.15);">
              <span class="text-body font-semibold" style="color: var(--color-blush);">{{ block.settings.author | truncate: 2, "" }}</span>
            </div>
            <div>
              <p class="text-body-sm font-medium" style="color: var(--color-foreground);">{{ block.settings.author }}</p>
              <div data-gs="test-stars" class="flex items-center gap-1 mt-1">
                {% for i in (1..5) %}
                  {% if i <= block.settings.rating %}
                    <svg class="w-4 h-4" style="color: var(--color-golden);" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% else %}
                    <svg class="w-4 h-4" style="color: rgba(196,162,101,0.25);" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Happy Review"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What They Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Amazing work! The artist brought my character to life exactly as I imagined."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The level of detail and creativity is outstanding. My OC has never looked better!",
            "author": "Sarah Chen",
            "rating": 5,
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Fast delivery, great communication, and the art exceeded my expectations.",
            "author": "Mike Johnson",
            "rating": 5,
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I've commissioned many artists but this was by far the best experience.",
            "author": "Alex Rivera",
            "rating": 5,
          }
        }
      ]
    }
  ]
}
{% endschema %}
