<section data-gs-section="testimonials" class="relative py-20 overflow-x-hidden" style="background: var(--bg-testimonials);">
  <div class="relative section-content">
    <div class="text-center mb-16">
      <p data-gs="test-heading" class="text-caption tracking-[0.25em] uppercase mb-4 font-medium inline-flex items-center gap-2 justify-center" style="color: var(--color-blush);">
        <span class="w-8 h-px" style="background: linear-gradient(to right, transparent, var(--color-blush));"></span>
        {{ section.settings.subheading }}
        <span class="w-8 h-px" style="background: linear-gradient(to left, transparent, var(--color-blush));"></span>
      </p>
      <h2 data-gs="test-heading" class="text-heading font-display" style="color: var(--color-foreground);">{{ section.settings.heading }}</h2>
    </div>
  </div>

  <!-- Two auto-scrolling rows, moving in opposite directions, looping infinitely.
       Each row is still a native overflow-x-auto track, so visitors can grab
       and manually scroll it too. Mobile only shows the first row. -->
  <div class="space-y-6">
    <div id="testimonial-track-1" class="testimonial-track flex gap-6 overflow-x-auto pb-2" data-direction="1" style="-ms-overflow-style:none; scrollbar-width:none;">
      {% for dup in (1..2) %}
        {% assign is_primary_copy = false %}
        {% if dup == 1 %}
          {% assign is_primary_copy = true %}
        {% endif %}
        {% for block in section.blocks %}
          {% render 'testimonial-card', block: block, animate: is_primary_copy, shopify_attrs: is_primary_copy %}
        {% endfor %}
      {% endfor %}
    </div>

    <div id="testimonial-track-2" class="testimonial-track flex gap-6 overflow-x-auto pb-2" data-direction="-1" style="-ms-overflow-style:none; scrollbar-width:none;">
      {% for dup in (1..2) %}
        {% for block in section.blocks %}
          {% render 'testimonial-card', block: block, animate: false, shopify_attrs: false %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <style>
    .testimonial-track::-webkit-scrollbar {
      display: none;
    }
    .testimonial-track {
      cursor: ew-resize;
      scroll-behavior: auto;
    }
  </style>
</section>

<script>
  (function () {
    var tracks = document.querySelectorAll('.testimonial-track');
    if (!tracks.length) return;

    var SPEED = 0.6; // px per frame

    tracks.forEach(function (track) {
      var direction = Number(track.dataset.direction) || 1;
      var paused = false;
      var half = 0;

      function measure() {
        // Content is rendered twice, so half the scroll width is exactly
        // one full loop of the real testimonials.
        half = track.scrollWidth / 2;
        if (direction < 0) {
          track.scrollLeft = half;
        }
      }

      function tick() {
        if (!paused && half > 0) {
          track.scrollLeft += direction * SPEED;

          if (direction > 0 && track.scrollLeft >= half) {
            track.scrollLeft -= half;
          } else if (direction < 0 && track.scrollLeft <= 0) {
            track.scrollLeft += half;
          }
        }
        requestAnimationFrame(tick);
      }

      function pause() {
        paused = true;
      }
      function resume() {
        paused = false;
      }

      track.addEventListener('mouseenter', pause);
      track.addEventListener('mouseleave', resume);
      track.addEventListener('pointerdown', pause);
      track.addEventListener('pointerup', resume);
      track.addEventListener('pointercancel', resume);
      track.addEventListener('touchstart', pause, { passive: true });
      track.addEventListener('touchend', resume);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(measure);
      }
      window.addEventListener('resize', measure);
      measure();
      requestAnimationFrame(tick);
    });
  })();
</script>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Happy Review"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What They Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Amazing work! The artist brought my character to life exactly as I imagined."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The level of detail and creativity is outstanding. My OC has never looked better!",
            "author": "Sarah Chen",
            "rating": 5,
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Fast delivery, great communication, and the art exceeded my expectations.",
            "author": "Mike Johnson",
            "rating": 5,
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I've commissioned many artists but this was by far the best experience.",
            "author": "Alex Rivera",
            "rating": 5,
          }
        }
      ]
    }
  ]
}
{% endschema %}
